# Managed by PerfLens. Do not remove this marker from generated service units.
[Unit]
Description=PerfLens unprivileged broker for the paranoid=3 Helper
Documentation=https://github.com/link0-o/PerfLens
Requires=perflens-privileged-helper.service
After=local-fs.target perflens-privileged-helper.service

[Service]
Type=simple
User=perflens
Group=perflens
SupplementaryGroups=perflens-internal
ExecStart=/usr/bin/perflens-collector --socket /run/perflens/collector.sock --policy /etc/perflens/collector.toml
RuntimeDirectory=perflens
RuntimeDirectoryMode=0750
StateDirectory=perflens
StateDirectoryMode=0750
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
ReadOnlyPaths=/run/perflens-helper /var/lib/perflens-helper
ReadWritePaths=/run/perflens /var/lib/perflens
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
