# Managed by PerfLens. Do not remove this marker from generated service units.
[Unit]
Description=PerfLens restricted performance collector
Documentation=https://github.com/link0-o/PerfLens
After=local-fs.target

[Service]
Type=simple
User=perflens
Group=perflens
ExecStart=/usr/bin/perflens-collector --socket /run/perflens/collector.sock --policy /etc/perflens/collector.toml
RuntimeDirectory=perflens
RuntimeDirectoryMode=0750
StateDirectory=perflens
StateDirectoryMode=0750
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_PERFMON
AmbientCapabilities=CAP_PERFMON
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
ReadWritePaths=/run/perflens /var/lib/perflens
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
