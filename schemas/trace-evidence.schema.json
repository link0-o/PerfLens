      "type": "object"
    },
    "TraceQuality": {
      "additionalProperties": false,
      "description": "Conserved conversion counts and the evidence quality they imply.\n\n``input_event_count`` counts records observed by the converter. Every\nobserved record is either emitted, merged as non-emitting enrichment, or\nassigned exactly one drop category. A source record may also expand into\nmore than one scoped public event; ``expanded_derived_event_count`` is the\nexact number of additional events created by that expansion. Kernel-\nreported lost events were never observed, while unpaired events may remain\nin the emitted evidence, so both are tracked separately from that equality.",
      "properties": {
        "diagnostics_truncated": {
          "default": false,
          "title": "Diagnostics Truncated",
          "type": "boolean"
        },
        "duplicate_event_count": {
          "minimum": 0,
          "title": "Duplicate Event Count",
          "type": "integer"
        },
        "emitted_event_count": {
          "minimum": 0,
          "title": "Emitted Event Count",
          "type": "integer"
        },
        "expanded_derived_event_count": {
          "default": 0,
          "minimum": 0,
          "title": "Expanded Derived Event Count",
          "type": "integer"
        },
        "foreign_event_dropped_count": {
          "minimum": 0,
          "title": "Foreign Event Dropped Count",
          "type": "integer"
        },
        "input_event_count": {
          "minimum": 0,
          "title": "Input Event Count",
          "type": "integer"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "lost_event_count": {
          "minimum": 0,
          "title": "Lost Event Count",
          "type": "integer"
        },
        "malformed_event_count": {
          "minimum": 0,
          "title": "Malformed Event Count",
          "type": "integer"
        },
        "merged_enrichment_event_count": {
          "default": 0,
          "minimum": 0,
          "title": "Merged Enrichment Event Count",
          "type": "integer"
        },
        "out_of_order_event_count": {
          "minimum": 0,
          "title": "Out Of Order Event Count",
          "type": "integer"
        },
        "quality_status": {
          "enum": [
            "verified",
            "partial"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "truncated_event_count": {
          "minimum": 0,
          "title": "Truncated Event Count",
          "type": "integer"
        },
        "unpaired_event_count": {
          "minimum": 0,
          "title": "Unpaired Event Count",
          "type": "integer"
        },
        "unsupported_event_count": {
          "minimum": 0,
          "title": "Unsupported Event Count",
          "type": "integer"
        }
      },
      "required": [
        "quality_status",
        "input_event_count",
        "emitted_event_count",
        "lost_event_count",
        "malformed_event_count",
        "duplicate_event_count",
        "out_of_order_event_count",
        "unpaired_event_count",
        "unsupported_event_count",
        "truncated_event_count",
        "foreign_event_dropped_count"
      ],
      "title": "TraceQuality",
      "type": "object"
    },
    "TraceRawArtifactReference": {
