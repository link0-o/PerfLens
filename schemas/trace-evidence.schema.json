          "type": "string"
        },
        "output_format": {
          "const": "perflens_trace_ndjson_v1",
          "default": "perflens_trace_ndjson_v1",
          "title": "Output Format",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
