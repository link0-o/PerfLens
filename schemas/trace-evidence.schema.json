  "$defs": {
    "FutexWaitEvent": {
      "additionalProperties": false,
      "properties": {
        "call_stack": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TraceStackFrame"
          },
          "title": "Call Stack",
          "type": "array"
        },
        "cpu": {
          "minimum": 0,
          "title": "Cpu",
          "type": "integer"
        },
        "event_id": {
          "pattern": "^event-[a-f0-9]{16,64}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_index": {
          "minimum": 0,
          "title": "Event Index",
          "type": "integer"
        },
        "event_type": {
          "const": "futex_wait",
          "default": "futex_wait",
          "title": "Event Type",
          "type": "string"
        },
        "lock_id": {
          "pattern": "^lock-[a-f0-9]{20}$",
          "title": "Lock Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "wait",
            "wait_bitset",
            "wait_requeue_pi",
            "unknown"
          ],
          "title": "Operation",
          "type": "string"
        },
        "semantics": {
          "const": "candidate",
          "default": "candidate",
          "title": "Semantics",
          "type": "string"
        },
        "source_sequence": {
          "minimum": 0,
          "title": "Source Sequence",
          "type": "integer"
        },
        "target_pid": {
          "exclusiveMinimum": 0,
          "title": "Target Pid",
          "type": "integer"
        },
        "target_tid": {
          "exclusiveMinimum": 0,
          "title": "Target Tid",
          "type": "integer"
        },
        "timestamp_ns": {
          "minimum": 0,
          "title": "Timestamp Ns",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "event_index",
        "source_sequence",
        "timestamp_ns",
        "cpu",
        "target_pid",
        "target_tid",
        "lock_id",
        "operation"
      ],
      "title": "FutexWaitEvent",
      "type": "object"
    },
