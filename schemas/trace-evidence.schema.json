            "lock_wait_ended": "#/$defs/LockWaitEndedEvent",
            "sched_migrate": "#/$defs/SchedMigrateEvent",
            "sched_switch": "#/$defs/SchedSwitchEvent",
            "sched_wakeup": "#/$defs/SchedWakeupEvent"
          },
          "propertyName": "event_type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SchedSwitchEvent"
          },
          {
            "$ref": "#/$defs/SchedWakeupEvent"
          },
          {
            "$ref": "#/$defs/SchedMigrateEvent"
          },
          {
            "$ref": "#/$defs/LockWaitEvent"
          },
          {
            "$ref": "#/$defs/LockWaitEndedEvent"
          },
          {
            "$ref": "#/$defs/LockReleasedEvent"
          },
          {
            "$ref": "#/$defs/FutexWaitEvent"
          },
          {
            "$ref": "#/$defs/FutexWakeEvent"
          }
        ]
      },
      "title": "Events",
      "type": "array"
    },
    "evidence_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evidence Fingerprint",
      "type": "string"
    },
    "forbidden_conclusions": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Conclusions",
      "type": "array"
    },
    "input_bytes": {
      "exclusiveMinimum": 0,
      "title": "Input Bytes",
      "type": "integer"
    },
    "input_line_count": {
      "minimum": 0,
      "title": "Input Line Count",
      "type": "integer"
    },
    "input_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/TraceResourceLimits"
    },
    "mode": {
      "enum": [
        "sched",
        "off_cpu",
        "lock"
      ],
      "title": "Mode",
      "type": "string"
    },
    "normalized_ndjson_bytes": {
      "minimum": 0,
      "title": "Normalized Ndjson Bytes",
      "type": "integer"
    },
    "normalized_ndjson_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Normalized Ndjson Sha256",
      "type": "string"
    },
    "observation_window": {
      "$ref": "#/$defs/TraceObservationWindow"
    },
    "perflens_version": {
      "minLength": 1,
      "title": "Perflens Version",
      "type": "string"
    },
    "quality": {
      "$ref": "#/$defs/TraceQuality"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/TraceRawArtifactReference"
