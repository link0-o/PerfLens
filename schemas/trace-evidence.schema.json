    "TraceCaptureManifest": {
      "additionalProperties": false,
      "description": "Agent-visible identity and coverage of the private trace producer.\n\nA successful converter cannot prove that the producer observed every event required for a\nscheduler or off-CPU conclusion.  These fields keep that independent capture boundary in the\nevidence hash and prevent a partial ``perf -p`` capture from being relabeled as complete.",
      "properties": {
        "architecture": {
          "pattern": "^[A-Za-z0-9_.+-]{1,64}$",
          "title": "Architecture",
          "type": "string"
        },
        "backend_id": {
          "enum": [
            "target_filtered_kernel_v1",
            "stock_perf_pid_partial_v1",
            "verified_private_import_v1"
          ],
          "title": "Backend Id",
          "type": "string"
        },
        "backend_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Backend Version",
          "type": "string"
        },
        "byte_order": {
          "enum": [
            "little",
            "big"
          ],
          "title": "Byte Order",
          "type": "string"
        },
        "capture_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Capture Fingerprint",
          "type": "string"
        },
        "dynamic_thread_coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Dynamic Thread Coverage",
          "type": "string"
        },
        "event_formats": {
          "items": {
            "$ref": "#/$defs/TraceEventFormatIdentity"
          },
          "minItems": 1,
          "title": "Event Formats",
          "type": "array"
        },
        "external_wakeup_visibility": {
          "enum": [
            "complete",
            "partial",
            "not_applicable",
            "unknown"
          ],
          "title": "External Wakeup Visibility",
          "type": "string"
        },
        "foreign_metadata_before_userspace": {
          "title": "Foreign Metadata Before Userspace",
          "type": "boolean"
        },
        "kernel_release": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Kernel Release",
          "type": "string"
        },
        "mode": {
          "enum": [
            "sched",
            "off_cpu",
            "lock"
          ],
          "title": "Mode",
          "type": "string"
        },
        "pointer_size_bits": {
          "enum": [
            32,
            64
          ],
          "title": "Pointer Size Bits",
          "type": "integer"
        },
        "producer_path": {
          "minLength": 1,
          "title": "Producer Path",
          "type": "string"
        },
        "producer_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Producer Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "switch_in_visibility": {
          "enum": [
            "complete",
            "partial",
            "not_applicable",
            "unknown"
          ],
          "title": "Switch In Visibility",
          "type": "string"
        },
        "target_scope": {
          "enum": [
            "kernel_tgid_filtered",
            "per_task_partial",
            "verified_import"
          ],
          "title": "Target Scope",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "backend_id",
        "backend_version",
        "producer_path",
        "producer_sha256",
        "kernel_release",
        "architecture",
        "byte_order",
        "pointer_size_bits",
        "target_scope",
        "dynamic_thread_coverage",
        "switch_in_visibility",
        "external_wakeup_visibility",
        "foreign_metadata_before_userspace",
        "event_formats",
        "capture_fingerprint"
      ],
      "title": "TraceCaptureManifest",
      "type": "object"
    },
