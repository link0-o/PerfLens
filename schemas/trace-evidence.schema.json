    },
    "diagnostic_count": {
      "minimum": 0,
      "title": "Diagnostic Count",
      "type": "integer"
    },
    "events": {
      "items": {
        "discriminator": {
          "mapping": {
            "futex_wait": "#/$defs/FutexWaitEvent",
            "futex_wake": "#/$defs/FutexWakeEvent",
            "lock_released": "#/$defs/LockReleasedEvent",
