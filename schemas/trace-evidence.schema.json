        },
        "output_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Output Sha256",
          "type": "string"
        }
      },
      "required": [
        "collection_id",
        "mode",
        "collection_artifact_sha256",
        "output_sha256",
        "output_bytes",
        "capture"
