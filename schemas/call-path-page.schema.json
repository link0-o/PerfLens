        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Symbol"
    },
    "total_items": {
      "minimum": 0,
      "title": "Total Items",
      "type": "integer"
    }
  },
  "required": [
    "analysis_id",
    "symbol",
    "items",
    "total_items"
