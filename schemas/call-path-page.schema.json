        "frames",
        "weight",
        "record_count",
        "percent"
      ],
      "title": "CallPath",
      "type": "object"
    },
    "CallPathFrame": {
      "additionalProperties": false,
      "properties": {
        "dso": {
          "title": "Dso",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "dso"
      ],
      "title": "CallPathFrame",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
