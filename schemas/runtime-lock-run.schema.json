{
  "$defs": {
    "DockerRuntimeLockRunBinding": {
      "additionalProperties": false,
      "description": "Existing Docker evidence that authorizes and identifies one lock Run.",
      "properties": {
        "accounted_evidence_bytes": {
          "maximum": 268435456,
          "minimum": 1,
          "title": "Accounted Evidence Bytes",
          "type": "integer"
        },
        "actual_execution_binding": {
          "$ref": "#/$defs/RuntimeLockAdapterExecutionBinding"
        },
        "actual_runtime_characteristics": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
          "title": "Actual Runtime Characteristics",
          "type": "string"
        },
        "authorized_execution_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Authorized Execution Identity Sha256",
          "type": "string"
        },
        "build_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Build Content Sha256",
          "type": "string"
        },
        "build_id": {
          "pattern": "^docker-build-[a-f0-9]{20}$",
          "title": "Build Id",
          "type": "string"
        },
        "container_measurement_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Container Measurement Content Sha256",
          "type": "string"
        },
        "container_measurement_id": {
          "pattern": "^container-measurement-[a-f0-9]{20}$",
          "title": "Container Measurement Id",
          "type": "string"
        },
        "container_run_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Container Run Content Sha256",
          "type": "string"
        },
        "container_run_id": {
          "pattern": "^container-run-[a-f0-9]{20}$",
          "title": "Container Run Id",
          "type": "string"
        },
        "container_target_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Container Target Content Sha256",
          "type": "string"
        },
        "container_target_id": {
          "pattern": "^container-target-[a-f0-9]{20}$",
          "title": "Container Target Id",
          "type": "string"
        },
        "docker_optimization_session_artifact_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Docker Optimization Session Artifact Content Sha256",
          "type": "string"
        },
        "docker_optimization_session_artifact_id": {
          "pattern": "^docker-optimization-session-state-[a-f0-9]{20}$",
          "title": "Docker Optimization Session Artifact Id",
          "type": "string"
        },
        "docker_optimization_session_id": {
          "pattern": "^docker-optimization-session-[a-f0-9]{20}$",
          "title": "Docker Optimization Session Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.1",
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "docker_optimization_session_id",
        "docker_optimization_session_artifact_id",
        "docker_optimization_session_artifact_content_sha256",
        "build_id",
        "build_content_sha256",
        "container_target_id",
        "container_target_content_sha256",
        "container_run_id",
        "container_run_content_sha256",
        "container_measurement_id",
        "container_measurement_content_sha256",
        "authorized_execution_identity_sha256",
        "actual_execution_binding",
        "actual_runtime_characteristics",
        "accounted_evidence_bytes"
      ],
      "title": "DockerRuntimeLockRunBinding",
      "type": "object"
    },
    "RuntimeLockAdapterExecutionBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter_id": {
                "const": "java_jfr"
              }
            },
            "required": [
              "adapter_id"
            ]
          },
          "then": {
            "properties": {
              "tools": {
                "maxItems": 2,
                "minItems": 2
              }
            },
            "required": [
              "tools",
              "runtime_payload_identity_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "adapter_id": {
                "const": "cpython_threading"
              }
            },
            "required": [
              "adapter_id"
            ]
          },
          "then": {
            "properties": {
              "tools": {
                "maxItems": 1,
                "minItems": 1
              }
            },
            "required": [
              "tools",
              "runtime_payload_identity_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "adapter_id": {
                "const": "go_pprof"
              }
            },
            "required": [
              "adapter_id"
            ]
          },
          "then": {
            "properties": {
              "tools": {
                "maxItems": 2,
                "minItems": 2
              }
            },
            "required": [
              "tools"
            ]
          }
        }
      ],
      "description": "Public, path-free identity for one active Adapter configuration.",
      "properties": {
        "adapter_id": {
          "enum": [
            "native_pthread",
            "java_jfr",
            "cpython_threading",
            "go_pprof",
            "generic_ndjson_import"
          ],
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "backend_id": {
          "pattern": "^[a-z][a-z0-9._-]{0,127}$",
          "title": "Backend Id",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "duration_threshold_ns": {
          "anyOf": [
            {
              "maximum": 1000000000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Threshold Ns"
        },
        "execution_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Execution Identity Sha256",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Limitations",
          "type": "array"
        },
        "measurement_semantics": {
          "enum": [
            "exact",
            "thresholded",
            "sampled",
            "cumulative"
          ],
          "title": "Measurement Semantics",
          "type": "string"
        },
        "metadata_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Metadata Sha256",
          "type": "string"
        },
        "profile": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Profile",
          "type": "string"
        },
        "runtime_payload_identity_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Payload Identity Sha256"
        },
        "runtime_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runtime Version",
          "type": "string"
        },
        "toolchain_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Toolchain Identity Sha256",
          "type": "string"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuntimeLockAdapterToolBinding"
          },
          "maxItems": 16,
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "backend_id",
        "runtime_version",
        "profile",
        "measurement_semantics",
        "toolchain_identity_sha256",
        "configuration_sha256",
        "metadata_sha256",
        "execution_identity_sha256"
      ],
      "title": "RuntimeLockAdapterExecutionBinding",
      "type": "object"
    },
    "RuntimeLockAdapterToolBinding": {
      "additionalProperties": false,
      "description": "Path-free identity of one executable used by an active Adapter.",
      "properties": {
        "binary_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binary Sha256",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9_.+-]{1,64}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "binary_sha256"
      ],
      "title": "RuntimeLockAdapterToolBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "adapter_execution_identity_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "adapter_id": {
                "const": "java_jfr"
              }
            },
            "required": [
              "adapter_id"
            ]
          },
          {
            "properties": {
              "adapter_id": {
                "const": "cpython_threading"
              },
              "schema_version": {
                "const": "1.1"
              }
            },
            "required": [
              "schema_version",
              "adapter_id"
            ]
          },
          {
            "properties": {
              "adapter_id": {
                "const": "go_pprof"
              },
              "schema_version": {
                "const": "1.1"
              }
            },
            "required": [
              "schema_version",
              "adapter_id"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "adapter_execution_identity_sha256": {
            "type": "string"
          }
        },
        "required": [
          "adapter_execution_identity_sha256"
        ]
      }
    }
  ],
  "properties": {
    "adapter_execution_identity_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Execution Identity Sha256"
    },
    "adapter_id": {
      "enum": [
        "native_pthread",
        "java_jfr",
        "cpython_threading",
        "go_pprof",
        "generic_ndjson_import"
      ],
      "title": "Adapter Id",
      "type": "string"
    },
    "allowed_conclusions": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Conclusions",
      "type": "array"
    },
    "authorization_kind": {
      "anyOf": [
        {
          "enum": [
            "runtime_lock_session",
            "docker_optimization"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization Kind"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "correctness_status": {
      "enum": [
        "passed",
        "failed",
        "unavailable"
      ],
      "title": "Correctness Status",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "docker_optimization_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/DockerRuntimeLockRunBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "duration_seconds": {
      "maximum": 30,
      "minimum": 0,
      "title": "Duration Seconds",
      "type": "integer"
    },
    "event_count": {
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "evidence_bytes": {
      "maximum": 67108864,
      "minimum": 1,
      "title": "Evidence Bytes",
      "type": "integer"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "forbidden_conclusions": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Conclusions",
      "type": "array"
    },
    "measurement_semantics": {
      "enum": [
        "exact",
        "thresholded",
        "sampled",
        "cumulative"
      ],
      "title": "Measurement Semantics",
      "type": "string"
    },
    "operation_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Operation Identity Sha256",
      "type": "string"
    },
    "perflens_version": {
      "title": "Perflens Version",
      "type": "string"
    },
    "quality_status": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Quality Status",
      "type": "string"
    },
    "run_id": {
      "pattern": "^runtime-lock-run-[a-f0-9]{20}$",
      "title": "Run Id",
      "type": "string"
    },
    "runtime_lock_analysis_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Lock Analysis Content Sha256",
      "type": "string"
    },
    "runtime_lock_analysis_id": {
      "pattern": "^runtime-lock-analysis-[a-f0-9]{16,64}$",
      "title": "Runtime Lock Analysis Id",
      "type": "string"
    },
    "runtime_lock_evidence_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Lock Evidence Content Sha256",
      "type": "string"
    },
    "runtime_lock_evidence_id": {
      "pattern": "^runtime-lock-evidence-[a-f0-9]{16,64}$",
      "title": "Runtime Lock Evidence Id",
      "type": "string"
    },
    "runtime_lock_verification_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Lock Verification Content Sha256",
      "type": "string"
    },
    "runtime_lock_verification_id": {
      "pattern": "^runtime-lock-verification-[a-f0-9]{16,64}$",
      "title": "Runtime Lock Verification Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "session_artifact_content_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Artifact Content Sha256"
    },
    "session_artifact_id": {
      "anyOf": [
        {
          "pattern": "^runtime-lock-session-state-[a-f0-9]{20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Artifact Id"
    },
    "session_id": {
      "pattern": "^(?:runtime-lock-session|docker-optimization-session)-[a-f0-9]{20}$",
      "title": "Session Id",
      "type": "string"
    },
    "session_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Revision"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "target_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Target Identity Sha256",
      "type": "string"
    },
    "target_scope": {
      "enum": [
        "host_bound_process",
        "host_launched_workload",
        "managed_temporary_container",
        "docker_optimization",
        "controlled_import"
      ],
      "title": "Target Scope",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "workload_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Workload Identity Sha256",
      "type": "string"
    }
  },
  "required": [
    "perflens_version",
    "run_id",
    "created_at",
    "started_at",
    "finished_at",
    "session_id",
    "target_scope",
    "operation_identity_sha256",
    "target_identity_sha256",
    "adapter_id",
    "measurement_semantics",
    "workload_identity_sha256",
    "runtime_lock_evidence_id",
    "runtime_lock_evidence_content_sha256",
    "runtime_lock_analysis_id",
    "runtime_lock_analysis_content_sha256",
    "runtime_lock_verification_id",
    "runtime_lock_verification_content_sha256",
    "duration_seconds",
    "evidence_bytes",
    "event_count",
    "correctness_status",
    "quality_status",
    "allowed_conclusions",
    "forbidden_conclusions",
    "content_sha256"
  ],
  "title": "RuntimeLockRunArtifact",
  "type": "object"
}
