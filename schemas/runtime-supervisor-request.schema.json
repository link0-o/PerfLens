{
  "$defs": {
    "RuntimeSupervisorCpythonThreadingRequest": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "threshold_ns": {
                "const": 10000
              }
            }
          },
          "if": {
            "properties": {
              "semantics": {
                "const": "exact"
              }
            },
            "required": [
              "semantics"
            ]
          },
          "then": {
            "properties": {
              "threshold_ns": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "adapter": {
          "const": "cpython_threading",
          "default": "cpython_threading",
          "title": "Adapter",
          "type": "string"
        },
        "bootstrap": {
          "$ref": "#/$defs/RuntimeSupervisorFileIdentity"
        },
        "max_events": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Max Events",
          "type": "integer"
        },
        "output": {
          "$ref": "#/$defs/RuntimeSupervisorWritableFileIdentity"
        },
        "script": {
          "$ref": "#/$defs/RuntimeSupervisorFileIdentity"
        },
        "script_label": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Script Label",
          "type": "string"
        },
        "semantics": {
          "enum": [
            "exact",
            "thresholded"
          ],
          "title": "Semantics",
          "type": "string"
        },
        "threshold_ns": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Ns"
        }
      },
      "required": [
        "adapter",
        "bootstrap",
        "script",
        "script_label",
        "output",
        "semantics",
        "max_events",
        "threshold_ns"
      ],
      "title": "RuntimeSupervisorCpythonThreadingRequest",
      "type": "object"
    },
    "RuntimeSupervisorDirectoryIdentity": {
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "maximum": 1048575,
          "minimum": 3,
          "title": "Descriptor",
          "type": "integer"
        },
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "exclusiveMinimum": 0,
          "title": "Inode",
          "type": "integer"
        },
        "mode": {
          "maximum": 4095,
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        },
        "owner_uid": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Owner Uid",
          "type": "integer"
        }
      },
      "required": [
        "descriptor",
        "device",
        "inode",
        "owner_uid",
        "mode"
      ],
      "title": "RuntimeSupervisorDirectoryIdentity",
      "type": "object"
    },
    "RuntimeSupervisorFileIdentity": {
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "maximum": 1048575,
          "minimum": 3,
          "title": "Descriptor",
          "type": "integer"
        },
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "exclusiveMinimum": 0,
          "title": "Inode",
          "type": "integer"
        },
        "links": {
          "minimum": 0,
          "title": "Links",
          "type": "integer"
        },
        "mode": {
          "maximum": 4095,
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        },
        "owner_uid": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Owner Uid",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "exclusiveMinimum": 0,
          "maximum": 536870912,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "descriptor",
        "sha256",
        "device",
        "inode",
        "owner_uid",
        "mode",
        "links",
        "size"
      ],
      "title": "RuntimeSupervisorFileIdentity",
      "type": "object"
    },
    "RuntimeSupervisorJavaJfrPrintRequest": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "const": "java_jfr_print",
          "default": "java_jfr_print",
          "title": "Adapter",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/RuntimeSupervisorWritableFileIdentity"
        },
        "recording": {
          "$ref": "#/$defs/RuntimeSupervisorFileIdentity"
        },
        "recording_directory": {
          "$ref": "#/$defs/RuntimeSupervisorDirectoryIdentity"
        },
        "recording_name": {
          "pattern": "^java-jfr-[a-f0-9]{20}\\.jfr$",
          "title": "Recording Name",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "recording_directory",
        "recording_name",
        "recording",
        "output"
      ],
      "title": "RuntimeSupervisorJavaJfrPrintRequest",
      "type": "object"
    },
    "RuntimeSupervisorJavaJfrWorkloadRequest": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "const": "java_jfr_workload",
          "default": "java_jfr_workload",
          "title": "Adapter",
          "type": "string"
        },
        "jar": {
          "$ref": "#/$defs/RuntimeSupervisorFileIdentity"
        },
        "profile": {
          "$ref": "#/$defs/RuntimeSupervisorFileIdentity"
        },
        "recording": {
          "$ref": "#/$defs/RuntimeSupervisorWritableFileIdentity"
        }
      },
      "required": [
        "adapter",
        "jar",
        "profile",
        "recording"
      ],
      "title": "RuntimeSupervisorJavaJfrWorkloadRequest",
      "type": "object"
    },
    "RuntimeSupervisorNativePthreadRequest": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "threshold_ns": {
                "type": "integer"
              }
            }
          },
          "if": {
            "properties": {
              "semantics": {
                "const": "exact"
              }
            },
            "required": [
              "semantics"
            ]
          },
          "then": {
            "properties": {
              "threshold_ns": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "adapter": {
          "const": "native_pthread",
          "default": "native_pthread",
          "title": "Adapter",
          "type": "string"
        },
        "max_events": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Max Events",
          "type": "integer"
        },
        "output": {
          "$ref": "#/$defs/RuntimeSupervisorWritableFileIdentity"
        },
        "probe": {
          "$ref": "#/$defs/RuntimeSupervisorFileIdentity"
        },
        "semantics": {
          "enum": [
            "exact",
            "thresholded"
          ],
          "title": "Semantics",
          "type": "string"
        },
        "threshold_ns": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Ns"
        }
      },
      "required": [
        "adapter",
        "probe",
        "output",
        "semantics",
        "max_events",
        "threshold_ns"
      ],
      "title": "RuntimeSupervisorNativePthreadRequest",
      "type": "object"
    },
    "RuntimeSupervisorWritableFileIdentity": {
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "maximum": 1048575,
          "minimum": 3,
          "title": "Descriptor",
          "type": "integer"
        },
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "exclusiveMinimum": 0,
          "title": "Inode",
          "type": "integer"
        },
        "links": {
          "minimum": 0,
          "title": "Links",
          "type": "integer"
        },
        "maximum_size": {
          "exclusiveMinimum": 0,
          "maximum": 67108864,
          "title": "Maximum Size",
          "type": "integer"
        },
        "mode": {
          "const": 384,
          "default": 384,
          "title": "Mode",
          "type": "integer"
        },
        "owner_uid": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Owner Uid",
          "type": "integer"
        }
      },
      "required": [
        "descriptor",
        "device",
        "inode",
        "owner_uid",
        "mode",
        "links",
        "maximum_size"
      ],
      "title": "RuntimeSupervisorWritableFileIdentity",
      "type": "object"
    }
  },
  "$id": "https://github.com/link0-o/PerfLens/schemas/runtime-supervisor-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "adapter": {
                "const": "java_jfr_print"
              }
            },
            "required": [
              "adapter"
            ]
          }
        },
        "required": [
          "request"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "properties": {
    "arguments": {
      "items": {
        "maxLength": 65536,
        "type": "string"
      },
      "maxItems": 256,
      "title": "Arguments",
      "type": "array"
    },
    "executable": {
      "$ref": "#/$defs/RuntimeSupervisorFileIdentity"
    },
    "expected_parent_pid": {
      "exclusiveMinimum": 0,
      "maximum": 2147483647,
      "title": "Expected Parent Pid",
      "type": "integer"
    },
    "expected_supervisor_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Supervisor Sha256",
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "request": {
      "discriminator": {
        "mapping": {
          "cpython_threading": "#/$defs/RuntimeSupervisorCpythonThreadingRequest",
          "java_jfr_print": "#/$defs/RuntimeSupervisorJavaJfrPrintRequest",
          "java_jfr_workload": "#/$defs/RuntimeSupervisorJavaJfrWorkloadRequest",
          "native_pthread": "#/$defs/RuntimeSupervisorNativePthreadRequest"
        },
        "propertyName": "adapter"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RuntimeSupervisorNativePthreadRequest"
        },
        {
          "$ref": "#/$defs/RuntimeSupervisorJavaJfrWorkloadRequest"
        },
        {
          "$ref": "#/$defs/RuntimeSupervisorJavaJfrPrintRequest"
        },
        {
          "$ref": "#/$defs/RuntimeSupervisorCpythonThreadingRequest"
        }
      ],
      "title": "Request"
    },
    "request_id": {
      "pattern": "^[a-f0-9]{20}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "timeout_milliseconds": {
      "exclusiveMinimum": 0,
      "maximum": 30000,
      "title": "Timeout Milliseconds",
      "type": "integer"
    },
    "working_directory": {
      "$ref": "#/$defs/RuntimeSupervisorDirectoryIdentity"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "request_id",
    "expected_parent_pid",
    "expected_supervisor_sha256",
    "executable",
    "working_directory",
    "arguments",
    "timeout_milliseconds",
    "request"
  ],
  "title": "PerfLens Runtime Supervisor Request",
  "type": "object"
}
