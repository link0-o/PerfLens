{
  "$defs": {
    "ContainerCollectionCgroupBinding": {
      "additionalProperties": false,
      "properties": {
        "identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Identity Sha256",
          "type": "string"
        },
        "inode": {
          "exclusiveMinimum": 0,
          "title": "Inode",
          "type": "integer"
        },
        "version": {
          "const": "v2",
          "default": "v2",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "inode",
        "identity_sha256"
      ],
      "title": "ContainerCollectionCgroupBinding",
      "type": "object"
    },
    "ContainerCollectionNamespaceBinding": {
      "additionalProperties": false,
      "properties": {
        "cgroup_namespace_inode": {
          "exclusiveMinimum": 0,
          "title": "Cgroup Namespace Inode",
          "type": "integer"
        },
        "mount_namespace_inode": {
          "exclusiveMinimum": 0,
          "title": "Mount Namespace Inode",
          "type": "integer"
        },
        "pid_namespace_inode": {
          "exclusiveMinimum": 0,
          "title": "Pid Namespace Inode",
          "type": "integer"
        },
        "user_namespace_inode": {
          "exclusiveMinimum": 0,
          "title": "User Namespace Inode",
          "type": "integer"
        }
      },
      "required": [
        "pid_namespace_inode",
        "user_namespace_inode",
        "mount_namespace_inode",
        "cgroup_namespace_inode"
      ],
      "title": "ContainerCollectionNamespaceBinding",
      "type": "object"
    },
    "ContainerCollectionTargetBinding": {
      "additionalProperties": false,
      "description": "Privacy-safe Linux identity required to revalidate one Docker target.",
      "properties": {
        "adapter_recipe_id": {
          "enum": [
            "local-docker-read-v1",
            "local-docker-managed-v1"
          ],
          "title": "Adapter Recipe Id",
          "type": "string"
        },
        "adapter_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Adapter Sha256",
          "type": "string"
        },
        "cgroup": {
          "$ref": "#/$defs/ContainerCollectionCgroupBinding"
        },
        "container_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Container Identity Sha256",
          "type": "string"
        },
        "container_pid": {
          "exclusiveMinimum": 0,
          "title": "Container Pid",
          "type": "integer"
        },
        "executable_name": {
          "pattern": "^[^/\\x00]{1,255}$",
          "title": "Executable Name",
          "type": "string"
        },
        "host_pid": {
          "exclusiveMinimum": 0,
          "title": "Host Pid",
          "type": "integer"
        },
        "host_start_time_ticks": {
          "exclusiveMinimum": 0,
          "title": "Host Start Time Ticks",
          "type": "integer"
        },
        "host_uid": {
          "minimum": 0,
          "title": "Host Uid",
          "type": "integer"
        },
        "identity_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Identity Fingerprint",
          "type": "string"
        },
        "image_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Identity Sha256",
          "type": "string"
        },
        "namespace": {
          "$ref": "#/$defs/ContainerCollectionNamespaceBinding"
        },
        "rootful_risk_authorized": {
          "default": false,
          "title": "Rootful Risk Authorized",
          "type": "boolean"
        },
        "target_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Target Content Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^container-target-[a-f0-9]{20}$",
          "title": "Target Id",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "existing_container",
            "managed_temporary_container"
          ],
          "title": "Target Kind",
          "type": "string"
        },
        "uid_mapping": {
          "enum": [
            "rootless_same_uid",
            "rootful_same_uid",
            "rootful_cross_uid"
          ],
          "title": "Uid Mapping",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "target_kind",
        "target_content_sha256",
        "container_identity_sha256",
        "image_identity_sha256",
        "identity_fingerprint",
        "container_pid",
        "host_pid",
        "host_uid",
        "host_start_time_ticks",
        "executable_name",
        "namespace",
        "cgroup",
        "uid_mapping",
        "adapter_recipe_id",
        "adapter_sha256"
      ],
      "title": "ContainerCollectionTargetBinding",
      "type": "object"
    },
    "PerfStatMetric": {
      "additionalProperties": false,
      "properties": {
        "derived": {
          "default": false,
          "title": "Derived",
          "type": "boolean"
        },
        "event": {
          "title": "Event",
          "type": "string"
        },
        "run_time_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "perf-reported event measurement runtime, not workload wall time",
          "title": "Run Time Ns"
        },
        "running_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "perf event scheduling coverage (time running versus time enabled); this is not workload CPU utilization",
          "title": "Running Percent"
        },
        "status": {
          "enum": [
            "measured",
            "not_counted",
            "not_supported",
            "derived"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "event",
        "value",
        "unit",
        "status"
      ],
      "title": "PerfStatMetric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_event_source": {
      "default": "unknown",
      "enum": [
        "hardware",
        "software",
        "unknown"
      ],
      "title": "Actual Event Source",
      "type": "string"
    },
    "authorization": {
      "const": "explicit",
      "default": "explicit",
      "title": "Authorization",
      "type": "string"
    },
    "call_graph": {
      "anyOf": [
        {
          "enum": [
            "fp",
            "dwarf",
            "lbr"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call Graph"
    },
    "collection_id": {
      "title": "Collection Id",
      "type": "string"
    },
    "container_target": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContainerCollectionTargetBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "diagnostics": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "diagnostics_truncated": {
      "default": false,
      "title": "Diagnostics Truncated",
      "type": "boolean"
    },
    "duration_seconds": {
      "minimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "events": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Events",
      "type": "array"
    },
    "evidence_limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Limitations",
      "type": "array"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "fallback_used": {
      "default": false,
      "title": "Fallback Used",
      "type": "boolean"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "frequency_hz": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frequency Hz"
    },
    "metrics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PerfStatMetric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "mode": {
      "enum": [
        "record",
        "stat",
        "sched",
        "lock",
        "off_cpu"
      ],
      "title": "Mode",
      "type": "string"
    },
    "output_bytes": {
      "exclusiveMinimum": 0,
      "title": "Output Bytes",
      "type": "integer"
    },
    "output_format": {
      "enum": [
        "perf_data",
        "perf_stat_delimited"
      ],
      "title": "Output Format",
      "type": "string"
    },
    "output_owner_uid": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Owner Uid"
    },
    "output_path": {
      "title": "Output Path",
      "type": "string"
    },
    "output_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Output Sha256",
      "type": "string"
    },
    "perf_executable": {
      "title": "Perf Executable",
      "type": "string"
    },
    "record_event": {
      "anyOf": [
        {
          "enum": [
            "cycles",
            "cpu-clock"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Event"
    },
    "requested_event_source": {
      "default": "auto",
      "enum": [
        "auto",
        "hardware_required",
        "software_only"
      ],
      "title": "Requested Event Source",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "const": "complete",
      "default": "complete",
      "title": "Status",
      "type": "string"
    },
    "target_argument_count": {
      "minimum": 0,
      "title": "Target Argument Count",
      "type": "integer"
    },
    "target_argv_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Argv Sha256"
    },
    "target_executable": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Executable"
    },
    "target_pid": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Pid"
    },
    "target_runtime": {
      "default": "host",
      "enum": [
        "host",
        "docker"
      ],
      "title": "Target Runtime",
      "type": "string"
    },
    "target_type": {
      "enum": [
        "command",
        "pid"
      ],
      "title": "Target Type",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "collection_id",
    "mode",
    "target_type",
    "target_argument_count",
    "output_path",
    "output_sha256",
    "output_bytes",
    "output_format",
    "perf_executable",
    "started_at",
    "finished_at",
    "duration_seconds"
  ],
  "title": "CollectionArtifact",
  "type": "object"
}
