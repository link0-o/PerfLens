{
  "$defs": {
    "PerfStatMetric": {
      "additionalProperties": false,
      "properties": {
        "derived": {
          "default": false,
          "title": "Derived",
          "type": "boolean"
        },
        "event": {
          "title": "Event",
          "type": "string"
        },
        "run_time_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "perf-reported event measurement runtime, not workload wall time",
          "title": "Run Time Ns"
        },
        "running_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "perf event scheduling coverage (time running versus time enabled); this is not workload CPU utilization",
          "title": "Running Percent"
        },
        "status": {
          "enum": [
            "measured",
            "not_counted",
            "not_supported",
            "derived"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "event",
        "value",
        "unit",
        "status"
      ],
      "title": "PerfStatMetric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_event_source": {
      "default": "unknown",
      "enum": [
        "hardware",
        "software",
        "unknown"
      ],
      "title": "Actual Event Source",
      "type": "string"
    },
    "authorization": {
      "const": "explicit",
      "default": "explicit",
      "title": "Authorization",
      "type": "string"
    },
    "call_graph": {
      "anyOf": [
        {
          "enum": [
            "fp",
            "dwarf",
            "lbr"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call Graph"
    },
    "collection_id": {
      "title": "Collection Id",
      "type": "string"
    },
    "container_identity_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Identity Sha256"
    },
    "container_pid": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Pid"
    },
    "container_target_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Target Fingerprint"
    },
    "container_target_id": {
      "anyOf": [
        {
          "pattern": "^container-target-[a-f0-9]{20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Target Id"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "diagnostics_truncated": {
      "default": false,
      "title": "Diagnostics Truncated",
      "type": "boolean"
    },
    "duration_seconds": {
      "minimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "events": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Events",
      "type": "array"
    },
    "evidence_limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Limitations",
      "type": "array"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "fallback_used": {
      "default": false,
      "title": "Fallback Used",
      "type": "boolean"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "frequency_hz": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frequency Hz"
    },
    "metrics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PerfStatMetric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "mode": {
      "enum": [
        "record",
        "stat",
        "sched",
        "lock",
        "off_cpu"
      ],
      "title": "Mode",
      "type": "string"
    },
    "output_bytes": {
      "exclusiveMinimum": 0,
      "title": "Output Bytes",
      "type": "integer"
    },
    "output_format": {
      "enum": [
        "perf_data",
        "perf_stat_delimited"
      ],
      "title": "Output Format",
      "type": "string"
    },
    "output_owner_uid": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Owner Uid"
    },
    "output_path": {
      "title": "Output Path",
      "type": "string"
    },
    "output_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Output Sha256",
      "type": "string"
    },
    "perf_executable": {
      "title": "Perf Executable",
      "type": "string"
    },
    "record_event": {
      "anyOf": [
        {
          "enum": [
            "cycles",
            "cpu-clock"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Event"
    },
    "requested_event_source": {
      "default": "auto",
      "enum": [
        "auto",
        "hardware_required",
        "software_only"
      ],
      "title": "Requested Event Source",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "const": "complete",
      "default": "complete",
      "title": "Status",
      "type": "string"
    },
    "target_argument_count": {
      "minimum": 0,
      "title": "Target Argument Count",
      "type": "integer"
    },
    "target_argv_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Argv Sha256"
    },
    "target_executable": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Executable"
    },
    "target_pid": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Pid"
    },
    "target_runtime": {
      "default": "host",
      "enum": [
        "host",
        "docker"
      ],
      "title": "Target Runtime",
      "type": "string"
    },
    "target_type": {
      "enum": [
        "command",
        "pid"
      ],
      "title": "Target Type",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "collection_id",
    "mode",
    "target_type",
    "target_argument_count",
    "output_path",
    "output_sha256",
    "output_bytes",
    "output_format",
    "perf_executable",
    "started_at",
    "finished_at",
    "duration_seconds"
  ],
  "title": "CollectionArtifact",
  "type": "object"
}
