{
  "additionalProperties": false,
  "properties": {
    "backend": {
      "const": "privileged_broker",
      "title": "Backend",
      "type": "string"
    },
    "call_graph": {
      "anyOf": [
        {
          "enum": [
            "fp",
            "dwarf",
            "lbr"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call Graph"
    },
    "container_identity_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Identity Sha256"
    },
    "container_pid": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Pid"
    },
    "container_target_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Target Fingerprint"
    },
    "container_target_id": {
      "anyOf": [
        {
          "pattern": "^container-target-[a-f0-9]{20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Target Id"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Duration Seconds",
      "type": "number"
    },
    "events": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Events",
      "type": "array"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "string"
    },
    "fallback_allowed": {
      "default": false,
      "title": "Fallback Allowed",
      "type": "boolean"
    },
    "fallback_events": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fallback Events",
      "type": "array"
    },
    "fallback_record_event": {
      "anyOf": [
        {
          "const": "cpu-clock",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Record Event"
    },
    "frequency_hz": {
      "anyOf": [
        {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frequency Hz"
    },
    "max_output_bytes": {
      "exclusiveMinimum": 0,
      "title": "Max Output Bytes",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "record",
        "stat",
        "sched",
        "lock",
        "off_cpu"
      ],
      "title": "Mode",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^plan-[a-f0-9]{20}$",
      "title": "Plan Id",
      "type": "string"
    },
    "policy_status": {
      "enum": [
        "allowed",
        "denied"
      ],
      "title": "Policy Status",
      "type": "string"
    },
    "record_event": {
      "anyOf": [
        {
          "enum": [
            "cycles",
            "cpu-clock"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Event"
    },
    "requested_event_source": {
      "default": "auto",
      "enum": [
        "auto",
        "hardware_required",
        "software_only"
      ],
      "title": "Requested Event Source",
      "type": "string"
    },
    "required_privilege": {
      "enum": [
        "none",
        "cap_perfmon",
        "cap_sys_admin_or_policy_change"
      ],
      "title": "Required Privilege",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_pid": {
      "exclusiveMinimum": 0,
      "title": "Target Pid",
      "type": "integer"
    },
    "target_runtime": {
      "default": "host",
      "enum": [
        "host",
        "docker"
      ],
      "title": "Target Runtime",
      "type": "string"
    },
    "target_start_time_ticks": {
      "exclusiveMinimum": 0,
      "title": "Target Start Time Ticks",
      "type": "integer"
    },
    "target_type": {
      "const": "pid",
      "title": "Target Type",
      "type": "string"
    },
    "target_uid": {
      "minimum": 0,
      "title": "Target Uid",
      "type": "integer"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "mode",
    "target_type",
    "target_pid",
    "target_uid",
    "target_start_time_ticks",
    "backend",
    "duration_seconds",
    "max_output_bytes",
    "expires_at",
    "policy_status",
    "required_privilege"
  ],
  "title": "CollectionPlanArtifact",
  "type": "object"
}
