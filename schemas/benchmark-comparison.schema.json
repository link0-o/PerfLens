                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence Interval 95"
        },
        "improvement_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
