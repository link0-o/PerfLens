{
  "$defs": {
    "ContainerCollectionCgroupBinding": {
      "additionalProperties": false,
      "properties": {
        "identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Identity Sha256",
          "type": "string"
        },
        "inode": {
          "exclusiveMinimum": 0,
          "title": "Inode",
          "type": "integer"
        },
        "version": {
          "const": "v2",
          "default": "v2",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "inode",
        "identity_sha256"
      ],
      "title": "ContainerCollectionCgroupBinding",
      "type": "object"
    },
    "ContainerCollectionNamespaceBinding": {
      "additionalProperties": false,
      "properties": {
        "cgroup_namespace_inode": {
          "exclusiveMinimum": 0,
          "title": "Cgroup Namespace Inode",
          "type": "integer"
        },
        "mount_namespace_inode": {
          "exclusiveMinimum": 0,
          "title": "Mount Namespace Inode",
          "type": "integer"
        },
        "pid_namespace_inode": {
          "exclusiveMinimum": 0,
          "title": "Pid Namespace Inode",
          "type": "integer"
        },
        "user_namespace_inode": {
          "exclusiveMinimum": 0,
          "title": "User Namespace Inode",
          "type": "integer"
        }
      },
      "required": [
        "pid_namespace_inode",
        "user_namespace_inode",
        "mount_namespace_inode",
        "cgroup_namespace_inode"
      ],
      "title": "ContainerCollectionNamespaceBinding",
      "type": "object"
    },
    "ContainerCollectionTargetBinding": {
      "additionalProperties": false,
      "description": "Privacy-safe Linux identity required to revalidate one Docker target.",
      "properties": {
        "adapter_recipe_id": {
          "enum": [
            "local-docker-read-v1",
            "local-docker-managed-v1"
          ],
          "title": "Adapter Recipe Id",
          "type": "string"
        },
        "adapter_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Adapter Sha256",
          "type": "string"
        },
        "cgroup": {
          "$ref": "#/$defs/ContainerCollectionCgroupBinding"
        },
        "container_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Container Identity Sha256",
          "type": "string"
        },
        "container_pid": {
          "exclusiveMinimum": 0,
          "title": "Container Pid",
          "type": "integer"
        },
        "executable_name": {
          "pattern": "^[^/\\x00]{1,255}$",
          "title": "Executable Name",
          "type": "string"
        },
        "host_pid": {
          "exclusiveMinimum": 0,
          "title": "Host Pid",
          "type": "integer"
        },
        "host_start_time_ticks": {
          "exclusiveMinimum": 0,
          "title": "Host Start Time Ticks",
          "type": "integer"
        },
        "host_uid": {
          "minimum": 0,
          "title": "Host Uid",
          "type": "integer"
        },
        "identity_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Identity Fingerprint",
          "type": "string"
        },
        "image_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Identity Sha256",
          "type": "string"
        },
        "namespace": {
          "$ref": "#/$defs/ContainerCollectionNamespaceBinding"
        },
        "rootful_risk_authorized": {
          "default": false,
          "title": "Rootful Risk Authorized",
          "type": "boolean"
        },
        "target_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Target Content Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^container-target-[a-f0-9]{20}$",
          "title": "Target Id",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "existing_container",
            "managed_temporary_container"
          ],
          "title": "Target Kind",
          "type": "string"
        },
        "uid_mapping": {
          "enum": [
            "rootless_same_uid",
            "rootful_same_uid",
            "rootful_cross_uid"
          ],
          "title": "Uid Mapping",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "target_kind",
        "target_content_sha256",
        "container_identity_sha256",
        "image_identity_sha256",
        "identity_fingerprint",
        "container_pid",
        "host_pid",
        "host_uid",
        "host_start_time_ticks",
        "executable_name",
        "namespace",
        "cgroup",
        "uid_mapping",
        "adapter_recipe_id",
        "adapter_sha256"
      ],
      "title": "ContainerCollectionTargetBinding",
      "type": "object"
    },
    "LockAggregate": {
      "additionalProperties": false,
      "properties": {
        "call_paths": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TraceCallPathAggregate"
          },
          "title": "Call Paths",
          "type": "array"
        },
        "candidate_wait_event_count": {
          "minimum": 0,
          "title": "Candidate Wait Event Count",
          "type": "integer"
        },
        "candidate_wake_event_count": {
          "minimum": 0,
          "title": "Candidate Wake Event Count",
          "type": "integer"
        },
        "exact_hold_count": {
          "minimum": 0,
          "title": "Exact Hold Count",
          "type": "integer"
        },
        "exact_hold_duration": {
          "$ref": "#/$defs/NanosecondDistribution"
        },
        "exact_wait_count": {
          "minimum": 0,
          "title": "Exact Wait Count",
          "type": "integer"
        },
        "exact_wait_duration": {
          "$ref": "#/$defs/NanosecondDistribution"
        },
        "exact_wait_outcomes": {
          "items": {
            "$ref": "#/$defs/LockWaitOutcomeCount"
          },
          "title": "Exact Wait Outcomes",
          "type": "array"
        },
        "lock_id": {
          "pattern": "^lock-[a-f0-9]{20}$",
          "title": "Lock Id",
          "type": "string"
        },
        "lock_kind": {
          "enum": [
            "kernel_lock",
            "futex_candidate",
            "unknown"
          ],
          "title": "Lock Kind",
          "type": "string"
        },
        "owner_observed_count": {
          "minimum": 0,
          "title": "Owner Observed Count",
          "type": "integer"
        },
        "waiter_thread_count": {
          "minimum": 0,
          "title": "Waiter Thread Count",
          "type": "integer"
        },
        "worst_holds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LockHoldInterval"
          },
          "title": "Worst Holds",
          "type": "array"
        },
        "worst_waits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LockWaitInterval"
          },
          "title": "Worst Waits",
          "type": "array"
        }
      },
      "required": [
        "lock_id",
        "lock_kind",
        "exact_wait_count",
        "waiter_thread_count",
        "owner_observed_count",
        "exact_wait_duration",
        "exact_wait_outcomes",
        "exact_hold_count",
        "exact_hold_duration",
        "candidate_wait_event_count",
        "candidate_wake_event_count"
      ],
      "title": "LockAggregate",
      "type": "object"
    },
    "LockHoldInterval": {
      "additionalProperties": false,
      "properties": {
        "acquire_timestamp_ns": {
          "minimum": 0,
          "title": "Acquire Timestamp Ns",
          "type": "integer"
        },
        "call_stack": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TraceStackFrame"
          },
          "title": "Call Stack",
          "type": "array"
        },
        "hold_duration_ns": {
          "minimum": 0,
          "title": "Hold Duration Ns",
          "type": "integer"
        },
        "holder_tid": {
          "exclusiveMinimum": 0,
          "title": "Holder Tid",
          "type": "integer"
        },
        "lock_id": {
          "pattern": "^lock-[a-f0-9]{20}$",
          "title": "Lock Id",
          "type": "string"
        },
        "release_timestamp_ns": {
          "minimum": 0,
          "title": "Release Timestamp Ns",
          "type": "integer"
        }
      },
      "required": [
        "lock_id",
        "holder_tid",
        "acquire_timestamp_ns",
        "release_timestamp_ns",
        "hold_duration_ns"
      ],
      "title": "LockHoldInterval",
      "type": "object"
    },
    "LockProjectionAggregate": {
      "additionalProperties": false,
      "properties": {
        "call_path": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TraceStackFrame"
          },
          "title": "Call Path",
          "type": "array"
        },
        "candidate_wait_event_count": {
          "minimum": 0,
          "title": "Candidate Wait Event Count",
          "type": "integer"
        },
        "candidate_wake_event_count": {
          "minimum": 0,
          "title": "Candidate Wake Event Count",
          "type": "integer"
        },
        "exact_hold_duration": {
          "$ref": "#/$defs/NanosecondDistribution"
        },
        "exact_wait_duration": {
          "$ref": "#/$defs/NanosecondDistribution"
        },
        "path_resolved": {
          "title": "Path Resolved",
          "type": "boolean"
        },
        "projection_type": {
          "enum": [
            "thread",
            "call_path"
          ],
          "title": "Projection Type",
          "type": "string"
        },
        "target_tid": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Tid"
        }
      },
      "required": [
        "projection_type",
        "path_resolved",
        "exact_wait_duration",
        "exact_hold_duration",
        "candidate_wait_event_count",
        "candidate_wake_event_count"
      ],
      "title": "LockProjectionAggregate",
      "type": "object"
    },
    "LockWaitInterval": {
      "additionalProperties": false,
      "properties": {
        "call_stack": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TraceStackFrame"
          },
          "title": "Call Stack",
          "type": "array"
        },
        "lock_id": {
          "pattern": "^lock-[a-f0-9]{20}$",
          "title": "Lock Id",
          "type": "string"
        },
        "lock_kind": {
          "enum": [
            "kernel_lock",
            "futex_candidate",
            "unknown"
          ],
          "title": "Lock Kind",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "acquired",
            "timed_out",
            "interrupted",
            "failed",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "owner_target_tid": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Target Tid"
        },
        "wait_begin_timestamp_ns": {
          "minimum": 0,
          "title": "Wait Begin Timestamp Ns",
          "type": "integer"
        },
        "wait_duration_ns": {
          "minimum": 0,
          "title": "Wait Duration Ns",
          "type": "integer"
        },
        "wait_end_timestamp_ns": {
          "minimum": 0,
          "title": "Wait End Timestamp Ns",
          "type": "integer"
        },
        "waiter_tid": {
          "exclusiveMinimum": 0,
          "title": "Waiter Tid",
          "type": "integer"
        }
      },
      "required": [
        "lock_id",
        "lock_kind",
        "waiter_tid",
        "wait_begin_timestamp_ns",
        "wait_end_timestamp_ns",
        "wait_duration_ns",
        "outcome"
      ],
      "title": "LockWaitInterval",
      "type": "object"
    },
    "LockWaitOutcomeCount": {
      "additionalProperties": false,
      "properties": {
        "interval_count": {
          "minimum": 0,
          "title": "Interval Count",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "acquired",
            "timed_out",
            "interrupted",
            "failed",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "interval_count"
      ],
      "title": "LockWaitOutcomeCount",
      "type": "object"
    },
    "NanosecondDistribution": {
      "additionalProperties": false,
      "properties": {
        "maximum_ns": {
          "minimum": 0,
          "title": "Maximum Ns",
          "type": "integer"
        },
        "mean_ns": {
          "minimum": 0,
          "title": "Mean Ns",
          "type": "integer"
        },
        "minimum_ns": {
          "minimum": 0,
          "title": "Minimum Ns",
          "type": "integer"
        },
        "p50_ns": {
          "minimum": 0,
          "title": "P50 Ns",
          "type": "integer"
        },
        "p95_ns": {
          "minimum": 0,
          "title": "P95 Ns",
          "type": "integer"
        },
        "p99_ns": {
          "minimum": 0,
          "title": "P99 Ns",
          "type": "integer"
        },
        "percentiles_stable": {
          "title": "Percentiles Stable",
          "type": "boolean"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "total_ns": {
          "minimum": 0,
          "title": "Total Ns",
          "type": "integer"
        }
      },
      "required": [
        "sample_count",
        "total_ns",
        "minimum_ns",
        "mean_ns",
        "p50_ns",
        "p95_ns",
        "p99_ns",
        "maximum_ns",
        "percentiles_stable"
      ],
      "title": "NanosecondDistribution",
      "type": "object"
    },
    "TraceAnalysisWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "pattern": "^event-[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "target_tid": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Tid"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "TraceAnalysisWarning",
      "type": "object"
    },
    "TraceCallPathAggregate": {
      "additionalProperties": false,
      "properties": {
        "frames": {
          "items": {
            "$ref": "#/$defs/TraceStackFrame"
          },
          "minItems": 1,
          "title": "Frames",
          "type": "array"
        },
        "occurrence_count": {
          "exclusiveMinimum": 0,
          "title": "Occurrence Count",
          "type": "integer"
        }
      },
      "required": [
        "frames",
        "occurrence_count"
      ],
      "title": "TraceCallPathAggregate",
      "type": "object"
    },
    "TraceCaptureManifest": {
      "additionalProperties": false,
      "description": "Agent-visible identity and coverage of the private trace producer.\n\nA successful converter cannot prove that the producer observed every event required for a\nscheduler or off-CPU conclusion.  These fields keep that independent capture boundary in the\nevidence hash and prevent a partial ``perf -p`` capture from being relabeled as complete.",
      "properties": {
        "architecture": {
          "pattern": "^[A-Za-z0-9_.+-]{1,64}$",
          "title": "Architecture",
          "type": "string"
        },
        "backend_id": {
          "enum": [
            "target_filtered_kernel_v1",
            "stock_perf_pid_partial_v1",
            "verified_private_import_v1"
          ],
          "title": "Backend Id",
          "type": "string"
        },
        "backend_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Backend Version",
          "type": "string"
        },
        "byte_order": {
          "enum": [
            "little",
            "big"
          ],
          "title": "Byte Order",
          "type": "string"
        },
        "capture_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Capture Fingerprint",
          "type": "string"
        },
        "dynamic_thread_coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Dynamic Thread Coverage",
          "type": "string"
        },
        "event_formats": {
          "items": {
            "$ref": "#/$defs/TraceEventFormatIdentity"
          },
          "minItems": 1,
          "title": "Event Formats",
          "type": "array"
        },
        "external_wakeup_visibility": {
          "enum": [
            "complete",
            "partial",
            "not_applicable",
            "unknown"
          ],
          "title": "External Wakeup Visibility",
          "type": "string"
        },
        "foreign_metadata_before_userspace": {
          "title": "Foreign Metadata Before Userspace",
          "type": "boolean"
        },
        "kernel_release": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Kernel Release",
          "type": "string"
        },
        "mode": {
          "enum": [
            "sched",
            "off_cpu",
            "lock"
          ],
          "title": "Mode",
          "type": "string"
        },
        "pointer_size_bits": {
          "enum": [
            32,
            64
          ],
          "title": "Pointer Size Bits",
          "type": "integer"
        },
        "producer_path": {
          "minLength": 1,
          "title": "Producer Path",
          "type": "string"
        },
        "producer_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Producer Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "switch_in_visibility": {
          "enum": [
            "complete",
            "partial",
            "not_applicable",
            "unknown"
          ],
          "title": "Switch In Visibility",
          "type": "string"
        },
        "target_scope": {
          "enum": [
            "kernel_tgid_filtered",
            "per_task_partial",
            "verified_import"
          ],
          "title": "Target Scope",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "backend_id",
        "backend_version",
        "producer_path",
        "producer_sha256",
        "kernel_release",
        "architecture",
        "byte_order",
        "pointer_size_bits",
        "target_scope",
        "dynamic_thread_coverage",
        "switch_in_visibility",
        "external_wakeup_visibility",
        "foreign_metadata_before_userspace",
        "event_formats",
        "capture_fingerprint"
      ],
      "title": "TraceCaptureManifest",
      "type": "object"
    },
    "TraceClock": {
      "additionalProperties": false,
      "description": "Clock domain shared by all normalized trace timestamps.",
      "properties": {
        "clock": {
          "const": "monotonic",
          "default": "monotonic",
          "title": "Clock",
          "type": "string"
        },
        "source": {
          "default": "linux_perf",
          "enum": [
            "linux_perf",
            "linux_bpf"
          ],
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "const": "nanoseconds",
          "default": "nanoseconds",
          "title": "Unit",
          "type": "string"
        }
      },
      "title": "TraceClock",
      "type": "object"
    },
    "TraceConversionManifest": {
      "additionalProperties": false,
      "description": "Reproducible manifest for the fixed external trace conversion.",
      "properties": {
        "adapter": {
          "default": "perf_script_trace",
          "enum": [
            "perf_script_trace",
            "kernel_trace_ndjson"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "conversion_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Conversion Fingerprint",
          "type": "string"
        },
        "converter_path": {
          "minLength": 1,
          "title": "Converter Path",
          "type": "string"
        },
        "converter_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Converter Sha256",
          "type": "string"
        },
        "converter_version": {
          "minLength": 1,
          "title": "Converter Version",
          "type": "string"
        },
        "locale": {
          "const": "C",
          "default": "C",
          "title": "Locale",
          "type": "string"
        },
        "normalization_version": {
          "minLength": 1,
          "title": "Normalization Version",
          "type": "string"
        },
        "output_format": {
          "const": "perflens_trace_ndjson_v1",
          "default": "perflens_trace_ndjson_v1",
          "title": "Output Format",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "recipe_id": {
          "enum": [
            "sched-v1",
            "off-cpu-v1",
            "lock-v1"
          ],
          "title": "Recipe Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "recipe_id",
        "converter_path",
        "converter_sha256",
        "converter_version",
        "parser_version",
        "normalization_version",
        "argv",
        "conversion_fingerprint"
      ],
      "title": "TraceConversionManifest",
      "type": "object"
    },
    "TraceEventAccounting": {
      "additionalProperties": false,
      "properties": {
        "consumed": {
          "$ref": "#/$defs/TraceEventIdLedger"
        },
        "ignored": {
          "$ref": "#/$defs/TraceEventIdLedger"
        },
        "observed_event_count": {
          "minimum": 0,
          "title": "Observed Event Count",
          "type": "integer"
        },
        "unpaired": {
          "$ref": "#/$defs/TraceEventIdLedger"
        },
        "warning_count": {
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        },
        "warnings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TraceAnalysisWarning"
          },
          "title": "Warnings",
          "type": "array"
        },
        "warnings_truncated": {
          "title": "Warnings Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "observed_event_count",
        "consumed",
        "unpaired",
        "ignored",
        "warning_count",
        "warnings_truncated"
      ],
      "title": "TraceEventAccounting",
      "type": "object"
    },
    "TraceEventFormatIdentity": {
      "additionalProperties": false,
