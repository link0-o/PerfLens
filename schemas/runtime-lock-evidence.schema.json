    "RuntimeSourceManifest": {
      "additionalProperties": false,
      "description": "Versioned identity and semantics of one normalized input source.",
      "properties": {
        "adapter_id": {
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "backend_id": {
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$",
          "title": "Backend Id",
          "type": "string"
        },
        "backend_version": {
          "maxLength": 256,
