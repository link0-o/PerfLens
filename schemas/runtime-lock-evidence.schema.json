    "RuntimeAcquireEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "pattern": "^runtime-event-[a-f0-9]{16,64}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_index": {
          "minimum": 0,
          "title": "Event Index",
          "type": "integer"
        },
        "event_kind": {
          "const": "acquire",
          "default": "acquire",
          "title": "Event Kind",
          "type": "string"
        },
        "lock_id": {
          "anyOf": [
            {
              "pattern": "^runtime-lock-[a-f0-9]{20}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lock Id"
        },
        "lock_kind": {
          "enum": [
            "mutex",
            "recursive_mutex",
            "rwlock_read",
            "rwlock_write",
            "condition",
            "semaphore",
            "park",
            "gil",
            "runtime_internal",
            "channel",
            "wait_group",
            "custom",
            "unknown"
          ],
          "title": "Lock Kind",
          "type": "string"
        },
        "measurement_semantics": {
          "enum": [
            "exact",
            "thresholded",
            "sampled",
            "cumulative"
          ],
          "title": "Measurement Semantics",
          "type": "string"
        },
        "stack_id": {
          "anyOf": [
            {
              "pattern": "^runtime-stack-[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stack Id"
        },
        "target_tid": {
          "exclusiveMinimum": 0,
          "title": "Target Tid",
          "type": "integer"
        },
        "timestamp_ns": {
          "minimum": 0,
          "title": "Timestamp Ns",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "event_index",
        "timestamp_ns",
        "target_tid",
        "lock_kind",
        "measurement_semantics"
      ],
      "title": "RuntimeAcquireEvent",
      "type": "object"
    },
