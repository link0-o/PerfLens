            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampling Fraction"
        },
        "sampling_period": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampling Period"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_bytes": {
          "exclusiveMinimum": 0,
          "title": "Source Bytes",
          "type": "integer"
        },
        "source_format": {
          "enum": [
            "perflens_runtime_lock_ndjson_v1",
            "jfr_json_v1",
