        "hold_time_is_source_observed": {
          "title": "Hold Time Is Source Observed",
          "type": "boolean"
        },
        "measurement_semantics": {
          "enum": [
            "exact",
            "thresholded",
            "sampled",
            "cumulative"
          ],
          "title": "Measurement Semantics",
          "type": "string"
        },
        "owner_is_source_observed": {
          "title": "Owner Is Source Observed",
          "type": "boolean"
        },
        "runtime": {
          "enum": [
