{
  "additionalProperties": false,
  "properties": {
    "build_artifact_sha256": {
      "default": [],
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Build Artifact Sha256",
      "type": "array"
    },
    "cleanup_status": {
      "enum": [
        "removed",
        "preserved_for_manual_cleanup",
        "not_started"
      ],
      "title": "Cleanup Status",
      "type": "string"
    },
    "collection_ids": {
      "default": [],
      "items": {
        "pattern": "^collection-[a-f0-9]{16}$",
        "type": "string"
      },
      "title": "Collection Ids",
      "type": "array"
    },
    "container_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Container Identity Sha256",
      "type": "string"
    },
    "container_pid": {
      "exclusiveMinimum": 0,
      "title": "Container Pid",
      "type": "integer"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "host_pid": {
      "exclusiveMinimum": 0,
      "title": "Host Pid",
      "type": "integer"
    },
    "host_start_time_ticks": {
      "exclusiveMinimum": 0,
      "title": "Host Start Time Ticks",
      "type": "integer"
    },
    "image_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Image Identity Sha256",
      "type": "string"
    },
    "perflens_version": {
      "title": "Perflens Version",
      "type": "string"
    },
    "resource_context_id": {
      "anyOf": [
        {
          "pattern": "^container-resource-[a-f0-9]{20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Context Id"
    },
    "run_id": {
      "pattern": "^container-run-[a-f0-9]{20}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "pattern": "^container-session-[a-f0-9]{20}$",
      "title": "Session Id",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "exited",
        "terminated_after_collection",
        "failed_before_exec"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Target Identity Sha256",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "workload_spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Workload Spec Sha256",
      "type": "string"
    }
  },
  "required": [
    "perflens_version",
    "run_id",
    "created_at",
    "session_id",
    "workload_spec_sha256",
    "container_identity_sha256",
    "image_identity_sha256",
    "target_identity_sha256",
    "container_pid",
    "host_pid",
    "host_start_time_ticks",
    "started_at",
    "finished_at",
    "status",
    "cleanup_status",
    "content_sha256"
  ],
  "title": "ContainerRunArtifact",
  "type": "object"
}
