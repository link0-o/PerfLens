{
  "$defs": {
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "classification_id": {
          "title": "Classification Id",
          "type": "string"
        },
        "conclusion_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Conclusion Status",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "counter_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence",
          "type": "array"
        },
        "dso": {
          "title": "Dso",
          "type": "string"
        },
        "evidence_level": {
          "enum": [
            "L1",
            "L2"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "forbidden_conclusions": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Conclusions",
          "type": "array"
        },
        "hotspot_id": {
          "title": "Hotspot Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "next_steps": {
          "items": {
            "type": "string"
          },
          "title": "Next Steps",
          "type": "array"
        },
        "observation": {
          "title": "Observation",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minimum": 1,
          "title": "Rule Version",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "supporting_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "classification_id",
        "rule_id",
        "rule_version",
        "hotspot_id",
        "symbol",
        "dso",
        "category",
        "confidence",
        "evidence_level",
        "observation",
        "supporting_evidence",
        "counter_evidence",
        "missing_evidence",
        "limitations",
        "next_steps",
        "forbidden_conclusions"
      ],
      "title": "Classification",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "hotspot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hotspot Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "title": "Level",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "level",
        "kind",
        "statement",
        "artifact_id"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Analysis Content Sha256",
      "type": "string"
    },
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "classifications": {
      "items": {
        "$ref": "#/$defs/Classification"
      },
      "title": "Classifications",
      "type": "array"
    },
    "container_symbol_context_content_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Symbol Context Content Sha256"
    },
    "container_symbol_context_id": {
      "anyOf": [
        {
          "pattern": "^container-symbols-[a-f0-9]{20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Symbol Context Id"
    },
    "container_symbol_quality_status": {
      "anyOf": [
        {
          "enum": [
            "verified",
            "partial"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container Symbol Quality Status"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "missing_evidence": {
      "items": {
        "type": "string"
      },
      "title": "Missing Evidence",
      "type": "array"
    },
    "observations": {
      "items": {
        "type": "string"
      },
      "title": "Observations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "analysis_id",
    "analysis_content_sha256",
    "content_sha256",
    "status",
    "generated_at",
    "classifications",
    "observations",
    "limitations",
    "missing_evidence"
  ],
  "title": "DiagnosisBundle",
  "type": "object"
}
