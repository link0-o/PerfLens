{
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "enum": [
        "folded",
        "perf_script",
        "perf_data"
      ],
      "title": "Adapter",
      "type": "string"
    },
    "argv": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Argv",
      "type": "array"
    },
    "compatibility_fallbacks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Compatibility Fallbacks",
      "type": "array"
    },
    "converter_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Converter Path"
    },
    "converter_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Converter Sha256"
    },
    "converter_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Converter Version"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "locale": {
      "title": "Locale",
      "type": "string"
    },
    "normalization_version": {
      "title": "Normalization Version",
      "type": "string"
    },
    "parser_version": {
      "title": "Parser Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "transcript_bytes": {
      "minimum": 0,
      "title": "Transcript Bytes",
      "type": "integer"
    },
    "transcript_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Transcript Sha256",
      "type": "string"
    }
  },
  "required": [
    "adapter",
    "parser_version",
    "normalization_version",
    "locale",
    "transcript_sha256",
    "transcript_bytes"
  ],
  "title": "ConversionProvenance",
  "type": "object"
}
