{
  "$defs": {
    "HelperCollectionReadyResult": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "collection_ready",
          "title": "Kind",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^plan-[a-f0-9]{20}$",
          "title": "Plan Id",
          "type": "string"
        },
        "target_pid": {
          "exclusiveMinimum": 0,
          "title": "Target Pid",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "plan_id",
        "target_pid"
      ],
      "title": "HelperCollectionReadyResult",
      "type": "object"
    },
    "HelperCollectionResult": {
      "additionalProperties": false,
      "properties": {
        "actual_event_source": {
          "enum": [
            "hardware",
            "software"
          ],
          "title": "Actual Event Source",
          "type": "string"
        },
        "artifact_name": {
          "pattern": "^plan-[a-f0-9]{20}\\.(stat\\.csv|perf\\.data)$",
          "title": "Artifact Name",
          "type": "string"
        },
        "events": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Events",
          "type": "array"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "enum": [
                "hardware_probe_skipped_for_short_collection",
                "hardware_probe_failed",
                "hardware_probe_produced_no_usable_counts",
                "hardware_execution_failed_after_probe"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "fallback_used": {
          "title": "Fallback Used",
          "type": "boolean"
        },
        "finished_at_unix_milliseconds": {
          "exclusiveMinimum": 0,
          "title": "Finished At Unix Milliseconds",
          "type": "integer"
        },
        "kind": {
          "const": "collection",
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "enum": [
            "record",
            "stat"
          ],
          "title": "Mode",
          "type": "string"
        },
        "output_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 1099511627776,
          "title": "Output Bytes",
          "type": "integer"
        },
        "output_format": {
          "enum": [
            "perf_data",
            "perf_stat_delimited"
          ],
          "title": "Output Format",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^plan-[a-f0-9]{20}$",
          "title": "Plan Id",
          "type": "string"
        },
        "record_event": {
          "anyOf": [
            {
              "enum": [
                "cycles",
                "cpu-clock"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Event"
        },
        "started_at_unix_milliseconds": {
          "exclusiveMinimum": 0,
          "title": "Started At Unix Milliseconds",
          "type": "integer"
        },
        "target_pid": {
          "exclusiveMinimum": 0,
          "title": "Target Pid",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "plan_id",
        "mode",
        "target_pid",
        "artifact_name",
        "output_bytes",
        "output_sha256",
        "output_format",
        "actual_event_source",
        "fallback_used",
        "started_at_unix_milliseconds",
        "finished_at_unix_milliseconds"
      ],
      "title": "HelperCollectionResult",
      "type": "object"
    },
    "HelperErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "title": "Recoverable",
          "type": "boolean"
        },
        "stage": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "code",
        "stage",
        "message",
        "recoverable"
      ],
      "title": "HelperErrorBody",
      "type": "object"
    },
    "HelperHealthResult": {
      "additionalProperties": false,
      "properties": {
        "helper_pid": {
          "exclusiveMinimum": 0,
          "title": "Helper Pid",
          "type": "integer"
        },
        "helper_uid": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Helper Uid",
          "type": "integer"
        },
        "helper_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Helper Version",
          "type": "string"
        },
        "kind": {
          "const": "health",
          "title": "Kind",
          "type": "string"
        },
        "privilege_mode": {
          "const": "paranoid3_helper",
          "title": "Privilege Mode",
          "type": "string"
        },
        "ready": {
          "const": true,
          "title": "Ready",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "helper_version",
        "helper_pid",
        "helper_uid",
        "privilege_mode",
        "ready"
      ],
      "title": "HelperHealthResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/HelperErrorBody"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "request_id": {
      "pattern": "^(unknown|request-[a-f0-9]{16,64})$",
      "title": "Request Id",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "collection": "#/$defs/HelperCollectionResult",
              "collection_ready": "#/$defs/HelperCollectionReadyResult",
              "health": "#/$defs/HelperHealthResult"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/HelperHealthResult"
            },
            {
              "$ref": "#/$defs/HelperCollectionReadyResult"
            },
            {
              "$ref": "#/$defs/HelperCollectionResult"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "schema_version": {
      "const": "1.3",
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "ok"
  ],
  "title": "HelperResponse",
  "type": "object"
}
