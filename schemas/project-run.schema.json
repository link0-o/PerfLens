    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "target_pid": {
      "exclusiveMinimum": 0,
      "title": "Target Pid",
      "type": "integer"
    },
    "target_start_time_ticks": {
      "exclusiveMinimum": 0,
      "title": "Target Start Time Ticks",
      "type": "integer"
    },
    "target_uid": {
      "minimum": 0,
      "title": "Target Uid",
      "type": "integer"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "workload_exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
