      "title": "Collection Id",
      "type": "string"
    },
    "executable": {
      "title": "Executable",
      "type": "string"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "mode": {
      "enum": [
        "record",
        "stat",
        "sched",
        "lock",
        "off_cpu"
