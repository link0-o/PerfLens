      "pattern": "^project-run-[a-f0-9]{20}$",
      "title": "Project Run Id",
      "type": "string"
    },
    "requested_duration_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Requested Duration Seconds",
      "type": "number"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
