{
  "additionalProperties": false,
  "properties": {
    "adapter_match": {
      "title": "Adapter Match",
      "type": "boolean"
    },
    "allowed_conclusions": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Conclusions",
      "type": "array"
    },
    "baseline_build_content_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Build Content Sha256"
    },
    "baseline_build_id": {
      "anyOf": [
        {
          "pattern": "^docker-build-[a-f0-9]{20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Build Id"
    },
    "baseline_measurement_id": {
      "anyOf": [
        {
          "pattern": "^container-measurement-[a-f0-9]{20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Measurement Id"
    },
    "baseline_quality_status": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Baseline Quality Status",
      "type": "string"
    },
    "baseline_resource_environment_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Resource Environment Sha256"
    },
    "baseline_run_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Baseline Run Content Sha256",
      "type": "string"
    },
    "baseline_run_id": {
      "pattern": "^runtime-lock-run-[a-f0-9]{20}$",
      "title": "Baseline Run Id",
      "type": "string"
    },
    "candidate_build_content_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Build Content Sha256"
    },
    "candidate_build_id": {
      "anyOf": [
        {
          "pattern": "^docker-build-[a-f0-9]{20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Build Id"
    },
    "candidate_measurement_id": {
      "anyOf": [
        {
          "pattern": "^container-measurement-[a-f0-9]{20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Measurement Id"
    },
    "candidate_quality_status": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Candidate Quality Status",
      "type": "string"
    },
    "candidate_resource_environment_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Resource Environment Sha256"
    },
    "candidate_run_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Run Content Sha256",
      "type": "string"
    },
    "candidate_run_id": {
      "pattern": "^runtime-lock-run-[a-f0-9]{20}$",
      "title": "Candidate Run Id",
      "type": "string"
    },
    "comparable": {
      "title": "Comparable",
      "type": "boolean"
    },
    "comparison_id": {
      "pattern": "^runtime-lock-comparison-[a-f0-9]{20}$",
      "title": "Comparison Id",
      "type": "string"
    },
    "comparison_kind": {
      "anyOf": [
        {
          "enum": [
            "runtime_lock_session",
            "docker_optimization"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comparison Kind"
    },
    "conclusion": {
      "enum": [
        "verified_improvement",
        "candidate_improvement",
        "candidate_regression",
        "no_material_change",
        "not_comparable"
      ],
      "title": "Conclusion",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "correctness_status": {
      "enum": [
        "passed",
        "failed",
        "unavailable"
      ],
