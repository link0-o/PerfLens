      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "deterministic_replay_passed": {
      "title": "Deterministic Replay Passed",
      "type": "boolean"
    },
    "docker_treatment_changed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Docker Treatment Changed"
    },
    "forbidden_conclusions": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Conclusions",
      "type": "array"
    },
    "improved_metrics": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Improved Metrics",
      "type": "array"
    },
    "minimum_material_change_percent": {
      "anyOf": [
        {
          "maximum": 100.0,
          "minimum": 1.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Material Change Percent"
    },
    "perflens_version": {
      "title": "Perflens Version",
      "type": "string"
    },
    "regressed_metrics": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Regressed Metrics",
      "type": "array"
    },
    "resource_comparison_content_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Comparison Content Sha256"
    },
    "resource_comparison_id": {
      "anyOf": [
        {
          "pattern": "^container-comparison-[a-f0-9]{20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Comparison Id"
    },
    "resource_environment_match": {
      "title": "Resource Environment Match",
      "type": "boolean"
    },
    "resource_transfer_status": {
      "enum": [
        "no_observed_regression",
        "regression",
        "incomplete"
      ],
      "title": "Resource Transfer Status",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "semantics_match": {
      "title": "Semantics Match",
      "type": "boolean"
    },
    "session_id": {
      "pattern": "^(?:runtime-lock-session|docker-optimization-session)-[a-f0-9]{20}$",
      "title": "Session Id",
      "type": "string"
    },
    "threshold_or_sampling_match": {
      "title": "Threshold Or Sampling Match",
      "type": "boolean"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "workload_match": {
      "title": "Workload Match",
      "type": "boolean"
    }
  },
  "required": [
    "perflens_version",
    "comparison_id",
    "created_at",
    "session_id",
    "baseline_run_id",
    "baseline_run_content_sha256",
    "candidate_run_id",
    "candidate_run_content_sha256",
    "adapter_match",
    "semantics_match",
    "threshold_or_sampling_match",
    "workload_match",
    "resource_environment_match",
    "baseline_quality_status",
    "candidate_quality_status",
    "correctness_status",
    "deterministic_replay_passed",
    "resource_transfer_status",
    "comparable",
    "conclusion",
    "allowed_conclusions",
    "forbidden_conclusions",
    "content_sha256"
  ],
  "title": "RuntimeLockComparisonArtifact",
  "type": "object"
}
