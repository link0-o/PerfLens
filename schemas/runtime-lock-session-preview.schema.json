{
  "$defs": {
    "RuntimeLockSessionBudget": {
      "additionalProperties": false,
      "properties": {
        "hard_expiry_seconds": {
          "default": 3600,
          "maximum": 3600,
          "minimum": 1,
          "title": "Hard Expiry Seconds",
          "type": "integer"
        },
        "max_active_seconds": {
          "default": 1200,
          "maximum": 1200,
          "minimum": 1,
          "title": "Max Active Seconds",
          "type": "integer"
        },
        "max_adapter_concurrency": {
          "const": 1,
          "default": 1,
          "title": "Max Adapter Concurrency",
          "type": "integer"
        },
        "max_artifact_bytes": {
          "default": 67108864,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max Artifact Bytes",
          "type": "integer"
        },
        "max_collection_duration_seconds": {
          "default": 30,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Collection Duration Seconds",
          "type": "integer"
        },
        "max_evidence_bytes": {
          "default": 536870912,
          "maximum": 536870912,
          "minimum": 1,
          "title": "Max Evidence Bytes",
          "type": "integer"
        },
        "max_exact_duration_seconds": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Exact Duration Seconds",
          "type": "integer"
        },
        "max_exact_events": {
          "default": 20000,
          "maximum": 20000,
          "minimum": 1,
          "title": "Max Exact Events",
          "type": "integer"
        },
        "max_workload_runs": {
          "default": 6,
          "maximum": 6,
          "minimum": 1,
          "title": "Max Workload Runs",
          "type": "integer"
        }
      },
      "title": "RuntimeLockSessionBudget",
      "type": "object"
    },
    "RuntimeLockWorkloadBinding": {
      "additionalProperties": false,
      "description": "Content identity for one explicitly reviewed project workload.\n\nPaths remain project-relative and the argument vector is shown in the\nauthorization Preview. Environment variables, absolute host paths and\ncredentials are intentionally absent.",
      "properties": {
        "adapter_id": {
          "enum": [
            "native_pthread",
            "java_jfr",
            "cpython_threading",
            "go_pprof",
            "generic_ndjson_import"
          ],
          "title": "Adapter Id",
          "type": "string"
        },
        "arguments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Arguments",
          "type": "array"
        },
        "program": {
          "title": "Program",
          "type": "string"
        },
        "program_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Program Sha256",
          "type": "string"
        },
        "program_size": {
          "exclusiveMinimum": 0,
          "maximum": 1073741824,
          "title": "Program Size",
          "type": "integer"
        },
        "working_directory": {
          "default": ".",
          "title": "Working Directory",
          "type": "string"
        },
        "workload_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Workload Identity Sha256",
          "type": "string"
        },
        "workload_kind": {
          "enum": [
            "native_elf",
            "java_archive",
            "python_script",
            "go_elf"
          ],
          "title": "Workload Kind",
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "workload_kind",
        "program",
        "program_sha256",
        "program_size",
        "workload_identity_sha256"
      ],
      "title": "RuntimeLockWorkloadBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_adapters": {
      "items": {
        "enum": [
          "native_pthread",
          "java_jfr",
          "cpython_threading",
          "go_pprof",
          "generic_ndjson_import"
        ],
        "type": "string"
      },
      "title": "Allowed Adapters",
      "type": "array"
    },
    "allowed_semantics": {
      "items": {
        "enum": [
          "exact",
          "thresholded",
          "sampled",
          "cumulative"
        ],
        "type": "string"
      },
      "title": "Allowed Semantics",
      "type": "array"
    },
    "authorization_summary_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Summary Sha256",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/RuntimeLockSessionBudget"
    },
    "capability_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Capability Content Sha256",
      "type": "string"
    },
    "capability_id": {
      "pattern": "^runtime-lock-capability-[a-f0-9]{20}$",
      "title": "Capability Id",
      "type": "string"
    },
    "client_connection_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Client Connection Identity Sha256",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "string"
    },
    "import_roots": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Import Roots",
      "type": "array"
    },
    "perflens_version": {
      "title": "Perflens Version",
      "type": "string"
    },
    "planned_actions": {
      "items": {
        "type": "string"
      },
      "title": "Planned Actions",
      "type": "array"
    },
    "preview_id": {
      "pattern": "^runtime-lock-preview-[a-f0-9]{20}$",
      "title": "Preview Id",
      "type": "string"
    },
    "project_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Project Identity Sha256",
      "type": "string"
    },
    "project_policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Project Policy Sha256",
      "type": "string"
    },
    "runtime_lock_config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Lock Config Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_scope": {
      "enum": [
        "host_launched_workload",
        "managed_temporary_container",
        "docker_optimization",
        "controlled_import"
      ],
      "title": "Target Scope",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "workload": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeLockWorkloadBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "perflens_version",
    "preview_id",
    "created_at",
    "expires_at",
    "project_identity_sha256",
    "client_connection_identity_sha256",
    "project_policy_sha256",
    "capability_id",
    "capability_content_sha256",
    "runtime_lock_config_sha256",
    "target_scope",
    "allowed_adapters",
    "allowed_semantics",
    "budget",
    "planned_actions",
    "authorization_summary_sha256",
    "content_sha256"
  ],
  "title": "RuntimeLockSessionPreviewArtifact",
  "type": "object"
}
