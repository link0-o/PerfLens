{
  "$defs": {
    "RuntimeLockAdapterExecutionBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter_id": {
                "const": "java_jfr"
              }
            },
            "required": [
              "adapter_id"
            ]
          },
          "then": {
            "properties": {
              "tools": {
                "maxItems": 2,
                "minItems": 2
              }
            },
            "required": [
              "tools",
              "runtime_payload_identity_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "adapter_id": {
                "const": "cpython_threading"
              }
            },
            "required": [
              "adapter_id"
            ]
          },
          "then": {
            "properties": {
              "tools": {
                "maxItems": 1,
                "minItems": 1
              }
            },
            "required": [
              "tools",
              "runtime_payload_identity_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "adapter_id": {
                "const": "go_pprof"
              }
            },
            "required": [
              "adapter_id"
            ]
          },
          "then": {
            "properties": {
              "tools": {
                "maxItems": 2,
                "minItems": 2
              }
            },
            "required": [
              "tools"
            ]
          }
        }
      ],
      "description": "Public, path-free identity for one active Adapter configuration.",
      "properties": {
        "adapter_id": {
          "enum": [
            "native_pthread",
            "java_jfr",
            "cpython_threading",
            "go_pprof",
            "generic_ndjson_import"
          ],
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "backend_id": {
          "pattern": "^[a-z][a-z0-9._-]{0,127}$",
          "title": "Backend Id",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "duration_threshold_ns": {
          "anyOf": [
            {
              "maximum": 1000000000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Threshold Ns"
        },
        "execution_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Execution Identity Sha256",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Limitations",
          "type": "array"
        },
        "measurement_semantics": {
          "enum": [
            "exact",
            "thresholded",
            "sampled",
            "cumulative"
          ],
          "title": "Measurement Semantics",
          "type": "string"
        },
        "metadata_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Metadata Sha256",
          "type": "string"
        },
        "profile": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Profile",
          "type": "string"
        },
        "runtime_payload_identity_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Payload Identity Sha256"
        },
        "runtime_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runtime Version",
          "type": "string"
        },
        "toolchain_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Toolchain Identity Sha256",
          "type": "string"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuntimeLockAdapterToolBinding"
          },
          "maxItems": 16,
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "backend_id",
        "runtime_version",
        "profile",
        "measurement_semantics",
        "toolchain_identity_sha256",
        "configuration_sha256",
        "metadata_sha256",
        "execution_identity_sha256"
      ],
      "title": "RuntimeLockAdapterExecutionBinding",
      "type": "object"
    },
    "RuntimeLockAdapterToolBinding": {
      "additionalProperties": false,
      "description": "Path-free identity of one executable used by an active Adapter.",
      "properties": {
        "binary_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binary Sha256",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9_.+-]{1,64}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "binary_sha256"
      ],
      "title": "RuntimeLockAdapterToolBinding",
      "type": "object"
    },
    "RuntimeLockProcessTargetBinding": {
      "additionalProperties": false,
      "description": "Identity of one same-UID host process and its literal loopback pprof listener.",
      "properties": {
        "loopback_address": {
          "const": "127.0.0.1",
          "default": "127.0.0.1",
          "title": "Loopback Address",
          "type": "string"
        },
        "loopback_port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Loopback Port",
          "type": "integer"
        },
        "socket_inode": {
          "exclusiveMinimum": 0,
          "title": "Socket Inode",
          "type": "integer"
        },
        "target_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Target Identity Sha256",
          "type": "string"
        },
        "target_pid": {
          "exclusiveMinimum": 0,
          "title": "Target Pid",
          "type": "integer"
        },
        "target_start_time_ticks": {
          "exclusiveMinimum": 0,
          "title": "Target Start Time Ticks",
          "type": "integer"
        },
        "target_uid": {
          "minimum": 0,
          "title": "Target Uid",
          "type": "integer"
        }
      },
      "required": [
        "target_pid",
        "target_uid",
        "target_start_time_ticks",
        "loopback_port",
        "socket_inode",
        "target_identity_sha256"
      ],
      "title": "RuntimeLockProcessTargetBinding",
      "type": "object"
    },
    "RuntimeLockSessionBudget": {
      "additionalProperties": false,
      "properties": {
        "hard_expiry_seconds": {
          "default": 3600,
          "maximum": 3600,
          "minimum": 1,
          "title": "Hard Expiry Seconds",
          "type": "integer"
        },
        "max_active_seconds": {
          "default": 1200,
          "maximum": 1200,
          "minimum": 1,
          "title": "Max Active Seconds",
          "type": "integer"
        },
        "max_adapter_concurrency": {
          "const": 1,
          "default": 1,
          "title": "Max Adapter Concurrency",
          "type": "integer"
        },
        "max_artifact_bytes": {
          "default": 67108864,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max Artifact Bytes",
          "type": "integer"
        },
        "max_collection_duration_seconds": {
          "default": 30,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Collection Duration Seconds",
          "type": "integer"
        },
        "max_evidence_bytes": {
          "default": 536870912,
          "maximum": 536870912,
          "minimum": 1,
          "title": "Max Evidence Bytes",
          "type": "integer"
        },
        "max_exact_duration_seconds": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Exact Duration Seconds",
          "type": "integer"
        },
        "max_exact_events": {
          "default": 20000,
          "maximum": 20000,
          "minimum": 1,
          "title": "Max Exact Events",
          "type": "integer"
        },
        "max_workload_runs": {
          "default": 6,
          "maximum": 6,
          "minimum": 1,
          "title": "Max Workload Runs",
          "type": "integer"
        }
      },
      "title": "RuntimeLockSessionBudget",
      "type": "object"
    },
    "RuntimeLockWorkloadBinding": {
      "additionalProperties": false,
      "description": "Content identity for one explicitly reviewed project workload.\n\nPaths remain project-relative and the argument vector is shown in the\nauthorization Preview. Environment variables, absolute host paths and\ncredentials are intentionally absent.",
      "properties": {
        "adapter_id": {
          "enum": [
            "native_pthread",
            "java_jfr",
            "cpython_threading",
            "go_pprof",
            "generic_ndjson_import"
          ],
          "title": "Adapter Id",
          "type": "string"
        },
        "arguments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Arguments",
          "type": "array"
        },
        "program": {
          "title": "Program",
          "type": "string"
        },
        "program_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Program Sha256",
          "type": "string"
        },
        "program_size": {
          "exclusiveMinimum": 0,
          "maximum": 1073741824,
          "title": "Program Size",
          "type": "integer"
        },
        "working_directory": {
          "default": ".",
          "title": "Working Directory",
          "type": "string"
        },
        "workload_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Workload Identity Sha256",
          "type": "string"
        },
        "workload_kind": {
          "enum": [
            "native_elf",
            "java_archive",
            "python_script",
            "go_elf"
          ],
          "title": "Workload Kind",
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "workload_kind",
        "program",
        "program_sha256",
        "program_size",
        "workload_identity_sha256"
      ],
      "title": "RuntimeLockWorkloadBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "adapter_execution_bindings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "workload": {
                "properties": {
                  "adapter_id": {
                    "const": "java_jfr"
                  }
                },
                "required": [
                  "adapter_id"
                ],
                "type": "object"
              }
            },
            "required": [
              "workload"
            ]
          },
          {
            "properties": {
              "schema_version": {
                "const": "1.1"
              },
              "workload": {
                "properties": {
                  "adapter_id": {
                    "const": "cpython_threading"
                  }
                },
                "required": [
                  "adapter_id"
                ],
                "type": "object"
              }
            },
            "required": [
              "schema_version",
              "workload"
            ]
          },
          {
            "properties": {
              "schema_version": {
                "const": "1.1"
              },
              "workload": {
                "properties": {
                  "adapter_id": {
                    "const": "go_pprof"
                  }
                },
                "required": [
                  "adapter_id"
                ],
                "type": "object"
              }
            },
            "required": [
              "schema_version",
              "workload"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "adapter_execution_bindings": {
            "maxItems": 1,
            "minItems": 1
          }
        },
        "required": [
          "adapter_execution_bindings"
        ]
      }
    }
  ],
  "properties": {
    "adapter_execution_bindings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuntimeLockAdapterExecutionBinding"
      },
      "title": "Adapter Execution Bindings",
      "type": "array"
    },
    "allowed_adapters": {
      "items": {
        "enum": [
          "native_pthread",
          "java_jfr",
          "cpython_threading",
          "go_pprof",
          "generic_ndjson_import"
        ],
        "type": "string"
      },
      "title": "Allowed Adapters",
      "type": "array"
    },
    "allowed_semantics": {
      "items": {
        "enum": [
          "exact",
          "thresholded",
          "sampled",
          "cumulative"
        ],
        "type": "string"
      },
      "title": "Allowed Semantics",
      "type": "array"
    },
    "authorization_summary_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Summary Sha256",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/RuntimeLockSessionBudget"
    },
    "capability_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Capability Content Sha256",
      "type": "string"
    },
    "capability_id": {
      "pattern": "^runtime-lock-capability-[a-f0-9]{20}$",
      "title": "Capability Id",
      "type": "string"
    },
    "client_connection_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Client Connection Identity Sha256",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "string"
    },
    "import_roots": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Import Roots",
      "type": "array"
    },
    "perflens_version": {
      "title": "Perflens Version",
      "type": "string"
    },
    "planned_actions": {
      "items": {
        "type": "string"
      },
      "title": "Planned Actions",
      "type": "array"
    },
    "preview_id": {
      "pattern": "^runtime-lock-preview-[a-f0-9]{20}$",
      "title": "Preview Id",
      "type": "string"
    },
    "process_target": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeLockProcessTargetBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Project Identity Sha256",
      "type": "string"
    },
    "project_policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Project Policy Sha256",
      "type": "string"
    },
    "runtime_lock_config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Lock Config Sha256",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "target_scope": {
      "enum": [
        "host_bound_process",
        "host_launched_workload",
        "managed_temporary_container",
        "docker_optimization",
        "controlled_import"
      ],
      "title": "Target Scope",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "workload": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeLockWorkloadBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "perflens_version",
    "preview_id",
    "created_at",
    "expires_at",
    "project_identity_sha256",
    "client_connection_identity_sha256",
    "project_policy_sha256",
    "capability_id",
    "capability_content_sha256",
    "runtime_lock_config_sha256",
    "target_scope",
    "allowed_adapters",
    "allowed_semantics",
    "budget",
    "planned_actions",
    "authorization_summary_sha256",
    "content_sha256"
  ],
  "title": "RuntimeLockSessionPreviewArtifact",
  "type": "object"
}
