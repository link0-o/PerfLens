    "CallPath": {
      "additionalProperties": false,
      "properties": {
        "frames": {
          "items": {
            "$ref": "#/$defs/CallPathFrame"
          },
          "title": "Frames",
          "type": "array"
        },
        "path_id": {
          "title": "Path Id",
          "type": "string"
        },
        "percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Percent",
          "type": "number"
        },
        "record_count": {
          "exclusiveMinimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "path_id",
        "frames",
        "weight",
        "record_count",
        "percent"
      ],
      "title": "CallPath",
      "type": "object"
    },
    "CallPathFrame": {
      "additionalProperties": false,
      "properties": {
        "dso": {
          "title": "Dso",
          "type": "string"
        },
        "normalization_merged": {
          "default": false,
          "title": "Normalization Merged",
          "type": "boolean"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "symbol_variant_count": {
          "description": "Exact raw-symbol variant count when symbol_variants_truncated is false; otherwise a conservative observed lower bound",
          "minimum": 1,
          "title": "Symbol Variant Count",
          "type": "integer"
        },
        "symbol_variants_truncated": {
          "default": false,
          "title": "Symbol Variants Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "symbol",
        "dso",
        "symbol_variant_count"
      ],
      "title": "CallPathFrame",
      "type": "object"
    },
    "CollectionEvidenceProvenance": {
      "additionalProperties": false,
      "properties": {
        "actual_event_source": {
          "enum": [
            "hardware",
            "software",
            "unknown"
          ],
          "title": "Actual Event Source",
          "type": "string"
        },
        "call_graph": {
          "anyOf": [
            {
              "enum": [
                "fp",
                "dwarf",
                "lbr"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Graph"
        },
        "collection_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Collection Artifact Sha256",
          "type": "string"
        },
        "collection_id": {
          "title": "Collection Id",
          "type": "string"
        },
        "container_target_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Target Content Sha256"
        },
        "container_target_id": {
          "anyOf": [
            {
              "pattern": "^container-target-[a-f0-9]{20}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Target Id"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "evidence_limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Limitations",
          "type": "array"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "fallback_used": {
          "title": "Fallback Used",
          "type": "boolean"
        },
        "frequency_hz": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency Hz"
        },
        "mode": {
          "enum": [
            "record",
            "sched",
            "lock",
            "off_cpu"
