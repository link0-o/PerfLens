{
  "$defs": {
    "CallPath": {
      "additionalProperties": false,
      "properties": {
        "frames": {
          "items": {
            "$ref": "#/$defs/CallPathFrame"
          },
          "title": "Frames",
          "type": "array"
        },
        "path_id": {
          "title": "Path Id",
          "type": "string"
        },
        "percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Percent",
          "type": "number"
        },
        "record_count": {
          "exclusiveMinimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "path_id",
        "frames",
        "weight",
        "record_count",
        "percent"
      ],
      "title": "CallPath",
      "type": "object"
    },
    "CallPathFrame": {
      "additionalProperties": false,
      "properties": {
        "dso": {
          "title": "Dso",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "dso"
      ],
      "title": "CallPathFrame",
      "type": "object"
    },
    "Hotspot": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "dso": {
          "title": "Dso",
          "type": "string"
        },
        "hotspot_id": {
          "title": "Hotspot Id",
          "type": "string"
        },
        "inclusive_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Inclusive Percent",
          "type": "number"
        },
        "inclusive_weight": {
          "minimum": 0,
          "title": "Inclusive Weight",
          "type": "integer"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "self_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Self Percent",
          "type": "number"
        },
        "self_weight": {
          "minimum": 0,
          "title": "Self Weight",
          "type": "integer"
        },
        "source_locations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Locations",
          "type": "array"
        },
        "stack_occurrence_count": {
          "minimum": 0,
          "title": "Stack Occurrence Count",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "thread_count": {
          "minimum": 0,
          "title": "Thread Count",
          "type": "integer"
        },
        "top_callees": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Top Callees",
          "type": "array"
        },
        "top_callers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Top Callers",
          "type": "array"
        }
      },
      "required": [
        "hotspot_id",
        "symbol",
        "dso",
        "self_weight",
        "inclusive_weight",
        "sample_count",
        "stack_occurrence_count",
        "self_percent",
        "inclusive_percent",
        "thread_count"
      ],
      "title": "Hotspot",
      "type": "object"
    },
    "ParseStatistics": {
      "additionalProperties": false,
      "properties": {
        "bytes_read": {
          "minimum": 0,
          "title": "Bytes Read",
          "type": "integer"
        },
        "malformed_records": {
          "minimum": 0,
          "title": "Malformed Records",
          "type": "integer"
        },
        "parsed_records": {
          "minimum": 0,
          "title": "Parsed Records",
          "type": "integer"
        },
        "skipped_records": {
          "minimum": 0,
          "title": "Skipped Records",
          "type": "integer"
        },
        "warning_count": {
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        },
        "warnings_truncated": {
          "title": "Warnings Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "parsed_records",
        "skipped_records",
        "malformed_records",
        "warning_count",
        "warnings_truncated",
        "bytes_read"
      ],
      "title": "ParseStatistics",
      "type": "object"
    },
    "ProfileMetadata": {
      "additionalProperties": false,
      "properties": {
        "aggregation_semantics": {
          "const": "unique_symbol_dso_per_sample",
          "title": "Aggregation Semantics",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "event": {
          "title": "Event",
          "type": "string"
        },
        "has_call_graph": {
          "title": "Has Call Graph",
          "type": "boolean"
        },
        "has_source_lines": {
          "title": "Has Source Lines",
          "type": "boolean"
        },
        "input_path": {
          "title": "Input Path",
          "type": "string"
        },
        "input_sha256": {
          "title": "Input Sha256",
          "type": "string"
        },
        "parse_statistics": {
          "$ref": "#/$defs/ParseStatistics"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "const": "folded",
          "title": "Source Type",
          "type": "string"
        },
        "total_weight": {
          "minimum": 0,
          "title": "Total Weight",
          "type": "integer"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "weight_source": {
          "title": "Weight Source",
          "type": "string"
        },
        "weight_unit": {
          "title": "Weight Unit",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "source_type",
        "input_path",
        "input_sha256",
        "created_at",
        "sample_count",
        "total_weight",
        "weight_unit",
        "weight_source",
        "event",
        "has_call_graph",
        "has_source_lines",
        "aggregation_semantics",
        "parse_statistics"
      ],
      "title": "ProfileMetadata",
      "type": "object"
    },
    "ResourceLimitsContract": {
      "additionalProperties": false,
      "properties": {
        "max_call_paths_output": {
          "exclusiveMinimum": 0,
          "title": "Max Call Paths Output",
          "type": "integer"
        },
        "max_hotspots_output": {
          "exclusiveMinimum": 0,
          "title": "Max Hotspots Output",
          "type": "integer"
        },
        "max_input_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Input Bytes",
          "type": "integer"
        },
        "max_line_chars": {
          "exclusiveMinimum": 0,
          "title": "Max Line Chars",
          "type": "integer"
        },
        "max_output_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_records": {
          "exclusiveMinimum": 0,
          "title": "Max Records",
          "type": "integer"
        },
        "max_stack_depth": {
          "exclusiveMinimum": 0,
          "title": "Max Stack Depth",
          "type": "integer"
        },
        "max_unique_call_paths": {
          "exclusiveMinimum": 0,
          "title": "Max Unique Call Paths",
          "type": "integer"
        },
        "max_unique_frames": {
          "exclusiveMinimum": 0,
          "title": "Max Unique Frames",
          "type": "integer"
        },
        "max_warnings": {
          "minimum": 0,
          "title": "Max Warnings",
          "type": "integer"
        }
      },
      "required": [
        "max_input_bytes",
        "max_records",
        "max_line_chars",
        "max_stack_depth",
        "max_unique_frames",
        "max_unique_call_paths",
        "max_warnings",
        "max_hotspots_output",
        "max_call_paths_output",
        "max_output_bytes"
      ],
      "title": "ResourceLimitsContract",
      "type": "object"
    },
    "Warning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "line_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Number"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "preview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Warning",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregation_semantics": {
      "const": "unique_symbol_dso_per_sample",
      "title": "Aggregation Semantics",
      "type": "string"
    },
    "analysis_fingerprint": {
      "title": "Analysis Fingerprint",
      "type": "string"
    },
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "call_paths": {
      "items": {
        "$ref": "#/$defs/CallPath"
      },
      "title": "Call Paths",
      "type": "array"
    },
    "hotspots": {
      "items": {
        "$ref": "#/$defs/Hotspot"
      },
      "title": "Hotspots",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/ResourceLimitsContract"
    },
    "metadata": {
      "$ref": "#/$defs/ProfileMetadata"
    },
    "perflens_version": {
      "title": "Perflens Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "perflens_version",
    "analysis_id",
    "analysis_fingerprint",
    "status",
    "aggregation_semantics",
    "metadata",
    "hotspots",
    "call_paths",
    "warnings",
    "limits"
  ],
  "title": "AnalysisArtifact",
  "type": "object"
}
