        "output_bytes": {
          "exclusiveMinimum": 0,
          "title": "Output Bytes",
          "type": "integer"
        },
        "output_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "record_event": {
          "anyOf": [
            {
              "enum": [
                "cycles",
                "cpu-clock"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Event"
        },
        "requested_event_source": {
          "enum": [
            "auto",
            "hardware_required",
            "software_only"
          ],
          "title": "Requested Event Source",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_runtime": {
          "default": "host",
          "enum": [
            "host",
            "docker"
          ],
          "title": "Target Runtime",
          "type": "string"
        }
      },
      "required": [
        "collection_id",
        "collection_artifact_sha256",
        "mode",
        "duration_seconds",
        "output_sha256",
        "output_bytes",
        "requested_event_source",
        "actual_event_source",
        "fallback_used"
