{
  "$defs": {
    "RuntimeCallPathAggregate": {
      "additionalProperties": false,
      "properties": {
        "cumulative_observation_count": {
          "minimum": 0,
          "title": "Cumulative Observation Count",
          "type": "integer"
        },
        "exact_holds": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "exact_waits": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "execution_context_count": {
          "minimum": 0,
          "title": "Execution Context Count",
          "type": "integer"
        },
        "lock_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lock Count"
        },
        "observed_or_estimated_wait_ns": {
          "minimum": 0,
          "title": "Observed Or Estimated Wait Ns",
          "type": "integer"
        },
        "owner_observed_count": {
          "minimum": 0,
          "title": "Owner Observed Count",
          "type": "integer"
        },
        "sampled_observation_count": {
          "minimum": 0,
          "title": "Sampled Observation Count",
          "type": "integer"
        },
        "stack_id": {
          "anyOf": [
            {
              "pattern": "^runtime-stack-[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stack Id"
        },
        "thresholded_waits": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        }
      },
      "required": [
        "exact_waits",
        "thresholded_waits",
        "sampled_observation_count",
        "cumulative_observation_count",
        "observed_or_estimated_wait_ns",
        "exact_holds",
        "owner_observed_count",
        "stack_id",
        "execution_context_count"
      ],
      "title": "RuntimeCallPathAggregate",
      "type": "object"
    },
    "RuntimeExecutionContextAggregate": {
      "additionalProperties": false,
      "properties": {
        "cumulative_observation_count": {
          "minimum": 0,
          "title": "Cumulative Observation Count",
          "type": "integer"
        },
        "exact_holds": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "exact_waits": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "execution_context_id": {
          "pattern": "^runtime-context-[a-f0-9]{16,64}$",
          "title": "Execution Context Id",
          "type": "string"
        },
        "lock_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lock Count"
        },
        "observed_or_estimated_wait_ns": {
          "minimum": 0,
          "title": "Observed Or Estimated Wait Ns",
          "type": "integer"
        },
        "owner_observed_count": {
          "minimum": 0,
          "title": "Owner Observed Count",
          "type": "integer"
        },
        "sampled_observation_count": {
          "minimum": 0,
          "title": "Sampled Observation Count",
          "type": "integer"
        },
        "thresholded_waits": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        }
      },
      "required": [
        "exact_waits",
        "thresholded_waits",
        "sampled_observation_count",
        "cumulative_observation_count",
        "observed_or_estimated_wait_ns",
        "exact_holds",
        "owner_observed_count",
        "execution_context_id"
      ],
      "title": "RuntimeExecutionContextAggregate",
      "type": "object"
    },
    "RuntimeLockAggregate": {
      "additionalProperties": false,
      "properties": {
        "cumulative_observation_count": {
          "minimum": 0,
          "title": "Cumulative Observation Count",
          "type": "integer"
        },
        "exact_holds": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "exact_waits": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "lock_id": {
          "anyOf": [
            {
              "pattern": "^runtime-lock-[a-f0-9]{20}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lock Id"
        },
        "lock_kind": {
          "enum": [
            "mutex",
            "recursive_mutex",
            "rwlock_read",
            "rwlock_write",
            "condition",
            "semaphore",
            "park",
            "gil",
            "runtime_internal",
            "channel",
            "wait_group",
            "custom",
            "unknown"
          ],
          "title": "Lock Kind",
          "type": "string"
        },
        "observed_or_estimated_wait_ns": {
          "minimum": 0,
          "title": "Observed Or Estimated Wait Ns",
          "type": "integer"
        },
        "owner_observed_count": {
          "minimum": 0,
          "title": "Owner Observed Count",
          "type": "integer"
        },
        "sampled_observation_count": {
          "minimum": 0,
          "title": "Sampled Observation Count",
          "type": "integer"
        },
        "thresholded_waits": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "top_stack_ids": {
          "default": [],
          "items": {
            "pattern": "^runtime-stack-[a-f0-9]{16,64}$",
            "type": "string"
          },
          "title": "Top Stack Ids",
          "type": "array"
        },
        "waiter_execution_context_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waiter Execution Context Count"
        },
        "waiter_thread_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waiter Thread Count"
        }
      },
      "required": [
        "exact_waits",
        "thresholded_waits",
        "sampled_observation_count",
        "cumulative_observation_count",
        "observed_or_estimated_wait_ns",
        "exact_holds",
        "owner_observed_count",
        "lock_id",
        "lock_kind"
      ],
      "title": "RuntimeLockAggregate",
      "type": "object"
    },
    "RuntimeLockKindAggregate": {
      "additionalProperties": false,
      "properties": {
        "cumulative_observation_count": {
          "minimum": 0,
          "title": "Cumulative Observation Count",
          "type": "integer"
        },
        "exact_holds": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "exact_waits": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "execution_context_count": {
          "minimum": 0,
          "title": "Execution Context Count",
          "type": "integer"
        },
        "lock_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lock Count"
        },
        "lock_kind": {
          "enum": [
            "mutex",
            "recursive_mutex",
            "rwlock_read",
            "rwlock_write",
            "condition",
            "semaphore",
            "park",
            "gil",
            "runtime_internal",
            "channel",
            "wait_group",
            "custom",
            "unknown"
          ],
          "title": "Lock Kind",
          "type": "string"
        },
        "observed_or_estimated_wait_ns": {
          "minimum": 0,
          "title": "Observed Or Estimated Wait Ns",
          "type": "integer"
        },
        "owner_observed_count": {
          "minimum": 0,
          "title": "Owner Observed Count",
          "type": "integer"
        },
        "sampled_observation_count": {
          "minimum": 0,
          "title": "Sampled Observation Count",
          "type": "integer"
        },
        "thresholded_waits": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        }
      },
      "required": [
        "exact_waits",
        "thresholded_waits",
        "sampled_observation_count",
        "cumulative_observation_count",
        "observed_or_estimated_wait_ns",
        "exact_holds",
        "owner_observed_count",
        "lock_kind",
        "execution_context_count"
      ],
      "title": "RuntimeLockKindAggregate",
      "type": "object"
    },
    "RuntimeLockResourceLimits": {
      "additionalProperties": false,
      "properties": {
        "max_diagnostics": {
          "default": 1000,
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Max Diagnostics",
          "type": "integer"
        },
        "max_exported_locks": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Exported Locks",
          "type": "integer"
        },
        "max_input_records": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Input Records",
          "type": "integer"
        },
        "max_line_bytes": {
          "default": 65536,
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Max Line Bytes",
          "type": "integer"
        },
        "max_output_bytes": {
          "default": 67108864,
          "exclusiveMinimum": 0,
          "maximum": 67108864,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_source_bytes": {
          "default": 67108864,
          "exclusiveMinimum": 0,
          "maximum": 67108864,
          "title": "Max Source Bytes",
          "type": "integer"
        },
        "max_stack_depth": {
          "default": 127,
          "exclusiveMinimum": 0,
          "maximum": 127,
          "title": "Max Stack Depth",
          "type": "integer"
        },
        "max_unique_locks": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Unique Locks",
          "type": "integer"
        },
        "max_unique_stacks": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Unique Stacks",
          "type": "integer"
        },
        "max_unique_target_tids": {
          "default": 65536,
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Max Unique Target Tids",
          "type": "integer"
        }
      },
      "title": "RuntimeLockResourceLimits",
      "type": "object"
    },
    "RuntimeNanosecondDistribution": {
      "additionalProperties": false,
      "properties": {
        "maximum_ns": {
          "minimum": 0,
          "title": "Maximum Ns",
          "type": "integer"
        },
        "mean_ns": {
          "minimum": 0,
          "title": "Mean Ns",
          "type": "integer"
        },
        "minimum_ns": {
          "minimum": 0,
          "title": "Minimum Ns",
          "type": "integer"
        },
        "p50_ns": {
          "minimum": 0,
          "title": "P50 Ns",
          "type": "integer"
        },
        "p95_ns": {
          "minimum": 0,
          "title": "P95 Ns",
          "type": "integer"
        },
        "p99_ns": {
          "minimum": 0,
          "title": "P99 Ns",
          "type": "integer"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "total_ns": {
          "minimum": 0,
          "title": "Total Ns",
          "type": "integer"
        }
      },
      "required": [
        "sample_count",
        "total_ns",
        "minimum_ns",
        "mean_ns",
        "p50_ns",
        "p95_ns",
        "p99_ns",
        "maximum_ns"
      ],
      "title": "RuntimeNanosecondDistribution",
      "type": "object"
    },
    "RuntimeProjectionCoverage": {
      "additionalProperties": false,
      "description": "Export/omission accounting for one bounded projection.",
      "properties": {
        "exported_row_count": {
          "minimum": 0,
          "title": "Exported Row Count",
          "type": "integer"
        },
        "omitted_cumulative_observation_count": {
          "minimum": 0,
          "title": "Omitted Cumulative Observation Count",
          "type": "integer"
        },
        "omitted_exact_hold_count": {
          "minimum": 0,
          "title": "Omitted Exact Hold Count",
          "type": "integer"
        },
        "omitted_exact_hold_ns": {
          "minimum": 0,
          "title": "Omitted Exact Hold Ns",
          "type": "integer"
        },
        "omitted_exact_wait_count": {
          "minimum": 0,
          "title": "Omitted Exact Wait Count",
          "type": "integer"
        },
        "omitted_exact_wait_ns": {
          "minimum": 0,
          "title": "Omitted Exact Wait Ns",
          "type": "integer"
        },
        "omitted_observed_or_estimated_wait_ns": {
          "minimum": 0,
          "title": "Omitted Observed Or Estimated Wait Ns",
          "type": "integer"
        },
        "omitted_owner_observed_count": {
          "minimum": 0,
          "title": "Omitted Owner Observed Count",
          "type": "integer"
        },
        "omitted_row_count": {
          "minimum": 0,
          "title": "Omitted Row Count",
          "type": "integer"
        },
        "omitted_sampled_observation_count": {
          "minimum": 0,
          "title": "Omitted Sampled Observation Count",
          "type": "integer"
        },
        "omitted_thresholded_wait_count": {
          "minimum": 0,
          "title": "Omitted Thresholded Wait Count",
          "type": "integer"
        },
        "omitted_thresholded_wait_ns": {
          "minimum": 0,
          "title": "Omitted Thresholded Wait Ns",
          "type": "integer"
        },
        "total_row_count": {
          "minimum": 0,
          "title": "Total Row Count",
          "type": "integer"
        }
      },
      "required": [
        "total_row_count",
        "exported_row_count",
        "omitted_row_count",
        "omitted_exact_wait_count",
        "omitted_exact_wait_ns",
        "omitted_thresholded_wait_count",
        "omitted_thresholded_wait_ns",
        "omitted_sampled_observation_count",
        "omitted_cumulative_observation_count",
        "omitted_observed_or_estimated_wait_ns",
        "omitted_exact_hold_count",
        "omitted_exact_hold_ns",
        "omitted_owner_observed_count"
      ],
      "title": "RuntimeProjectionCoverage",
      "type": "object"
    },
    "RuntimeWaitOutcomeAggregate": {
      "additionalProperties": false,
      "properties": {
        "cumulative_observation_count": {
          "minimum": 0,
          "title": "Cumulative Observation Count",
          "type": "integer"
        },
        "exact_holds": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "exact_waits": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "execution_context_count": {
          "minimum": 0,
          "title": "Execution Context Count",
          "type": "integer"
        },
        "lock_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lock Count"
        },
        "observed_or_estimated_wait_ns": {
          "minimum": 0,
          "title": "Observed Or Estimated Wait Ns",
          "type": "integer"
        },
        "owner_observed_count": {
          "minimum": 0,
          "title": "Owner Observed Count",
          "type": "integer"
        },
        "sampled_observation_count": {
          "minimum": 0,
          "title": "Sampled Observation Count",
          "type": "integer"
        },
        "thresholded_waits": {
          "$ref": "#/$defs/RuntimeNanosecondDistribution"
        },
        "wait_outcome": {
          "enum": [
            "acquired",
            "notified",
            "unparked",
            "timed_out",
            "interrupted",
            "failed",
            "unknown"
          ],
          "title": "Wait Outcome",
          "type": "string"
        }
      },
      "required": [
        "exact_waits",
        "thresholded_waits",
        "sampled_observation_count",
        "cumulative_observation_count",
        "observed_or_estimated_wait_ns",
        "exact_holds",
        "owner_observed_count",
        "wait_outcome",
        "execution_context_count"
      ],
      "title": "RuntimeWaitOutcomeAggregate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "aggregates": {
            "items": {
              "allOf": [
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "waiter_thread_count"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "waiter_execution_context_count"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "execution_context_aggregates",
          "call_path_aggregates",
          "wait_outcome_aggregates",
          "lock_kind_aggregates",
          "total_exact_wait_ns",
          "total_thresholded_wait_ns",
          "total_observed_or_estimated_wait_ns",
          "total_exact_hold_ns",
          "total_owner_observed_count",
          "lock_coverage",
          "execution_context_coverage",
          "call_path_coverage",
          "wait_outcome_coverage",
          "lock_kind_coverage"
        ]
      },
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "schema_version"
              ]
            }
          },
          {
            "properties": {
              "schema_version": {
                "const": "1.0"
              }
            },
            "required": [
              "schema_version"
            ]
          }
        ]
      },
      "then": {
        "allOf": [
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "execution_context_aggregates"
                  ]
                },
                {
                  "required": [
                    "call_path_aggregates"
                  ]
                },
                {
                  "required": [
                    "wait_outcome_aggregates"
                  ]
                },
                {
                  "required": [
                    "lock_kind_aggregates"
                  ]
                },
                {
                  "required": [
                    "total_exact_wait_ns"
                  ]
                },
                {
                  "required": [
                    "total_thresholded_wait_ns"
                  ]
                },
                {
                  "required": [
                    "total_observed_or_estimated_wait_ns"
                  ]
                },
                {
                  "required": [
                    "total_exact_hold_ns"
                  ]
                },
                {
                  "required": [
                    "total_owner_observed_count"
                  ]
                },
                {
                  "required": [
                    "lock_coverage"
                  ]
                },
                {
                  "required": [
                    "execution_context_coverage"
                  ]
                },
                {
                  "required": [
                    "call_path_coverage"
                  ]
                },
                {
                  "required": [
                    "wait_outcome_coverage"
                  ]
                },
                {
                  "required": [
                    "lock_kind_coverage"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "aggregates": {
                "items": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "waiter_execution_context_count"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "aggregates": {
      "items": {
        "$ref": "#/$defs/RuntimeLockAggregate"
      },
      "title": "Aggregates",
      "type": "array"
    },
    "allowed_conclusions": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Conclusions",
      "type": "array"
    },
    "analysis_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Analysis Fingerprint",
      "type": "string"
    },
    "call_path_aggregates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuntimeCallPathAggregate"
      },
      "title": "Call Path Aggregates",
      "type": "array"
    },
    "call_path_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeProjectionCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "content_bytes": {
      "exclusiveMinimum": 0,
      "title": "Content Bytes",
      "type": "integer"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "execution_context_aggregates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuntimeExecutionContextAggregate"
      },
      "title": "Execution Context Aggregates",
      "type": "array"
    },
    "execution_context_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeProjectionCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "forbidden_conclusions": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Conclusions",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/RuntimeLockResourceLimits"
    },
    "lock_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeProjectionCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lock_kind_aggregates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuntimeLockKindAggregate"
      },
      "title": "Lock Kind Aggregates",
      "type": "array"
    },
    "lock_kind_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeProjectionCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "measurement_semantics": {
      "enum": [
        "exact",
        "thresholded",
        "sampled",
        "cumulative"
      ],
      "title": "Measurement Semantics",
      "type": "string"
    },
    "omitted_lock_count": {
      "minimum": 0,
      "title": "Omitted Lock Count",
      "type": "integer"
    },
    "quality_status": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Quality Status",
      "type": "string"
    },
    "runtime": {
      "enum": [
        "c_cpp",
        "java",
        "python",
        "go",
        "custom"
      ],
      "title": "Runtime",
      "type": "string"
    },
    "runtime_lock_analysis_id": {
      "pattern": "^[a-z][a-z0-9-]*-[a-f0-9]{16,64}$",
      "title": "Runtime Lock Analysis Id",
      "type": "string"
    },
    "runtime_lock_evidence_content_bytes": {
      "exclusiveMinimum": 0,
      "title": "Runtime Lock Evidence Content Bytes",
      "type": "integer"
    },
    "runtime_lock_evidence_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Lock Evidence Content Sha256",
      "type": "string"
    },
    "runtime_lock_evidence_id": {
      "pattern": "^[a-z][a-z0-9-]*-[a-f0-9]{16,64}$",
      "title": "Runtime Lock Evidence Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
