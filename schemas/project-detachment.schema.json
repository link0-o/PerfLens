    },
    "next_steps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Next Steps",
      "type": "array"
    },
    "perflens_version": {
      "title": "Perflens Version",
      "type": "string"
    },
    "preserved_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Preserved Paths",
      "type": "array"
    },
    "project_root": {
      "title": "Project Root",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
