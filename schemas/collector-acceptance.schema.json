{
  "$defs": {
    "CollectorTraceModeAcceptance": {
      "additionalProperties": false,
      "description": "One advanced mode proven through capture, analysis, and replay verification.",
      "properties": {
        "analysis_id": {
          "title": "Analysis Id",
          "type": "string"
        },
        "analysis_status": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Analysis Status",
          "type": "string"
        },
        "emitted_event_count": {
          "exclusiveMinimum": 0,
          "title": "Emitted Event Count",
          "type": "integer"
        },
        "evidence_status": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "mode": {
          "enum": [
            "sched",
            "off_cpu",
            "lock"
          ],
          "title": "Mode",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "passed",
          "default": "passed",
          "title": "Status",
          "type": "string"
        },
        "trace_evidence_id": {
          "title": "Trace Evidence Id",
          "type": "string"
        },
        "verification_id": {
          "title": "Verification Id",
          "type": "string"
        },
        "verification_status": {
          "enum": [
            "verified",
            "partial"
          ],
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "trace_evidence_id",
        "evidence_status",
        "emitted_event_count",
        "analysis_id",
        "analysis_status",
        "verification_id",
        "verification_status"
      ],
      "title": "CollectorTraceModeAcceptance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_id": {
      "pattern": "^acceptance-[a-f0-9]{20}$",
      "title": "Acceptance Id",
      "type": "string"
    },
    "collection_id": {
      "title": "Collection Id",
      "type": "string"
    },
    "feature_profile": {
      "default": "cpu_only",
      "enum": [
        "cpu_only",
        "full_diagnostics"
      ],
      "title": "Feature Profile",
      "type": "string"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "hardware_collection_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hardware Collection Id"
    },
    "hardware_pmu_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hardware Pmu Reason"
    },
    "hardware_pmu_status": {
      "default": "unknown",
      "enum": [
        "available",
        "unavailable",
        "unknown"
      ],
      "title": "Hardware Pmu Status",
      "type": "string"
    },
    "metric_count": {
      "minimum": 0,
      "title": "Metric Count",
      "type": "integer"
    },
    "output_bytes": {
      "exclusiveMinimum": 0,
      "title": "Output Bytes",
      "type": "integer"
    },
    "output_path": {
      "title": "Output Path",
      "type": "string"
    },
    "output_sha256": {
      "title": "Output Sha256",
      "type": "string"
    },
    "perflens_version": {
      "title": "Perflens Version",
      "type": "string"
    },
    "probe_kind": {
      "const": "built_in_cpu",
      "default": "built_in_cpu",
      "title": "Probe Kind",
      "type": "string"
    },
    "requested_duration_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 5,
      "title": "Requested Duration Seconds",
      "type": "number"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "socket_path": {
      "title": "Socket Path",
      "type": "string"
    },
    "software_counting_status": {
      "default": "unknown",
      "enum": [
        "available",
        "unavailable",
        "unknown"
      ],
      "title": "Software Counting Status",
      "type": "string"
    },
    "software_sampling_collection_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Software Sampling Collection Id"
    },
    "software_sampling_status": {
      "default": "unknown",
      "enum": [
        "available",
        "unavailable",
        "unknown"
      ],
      "title": "Software Sampling Status",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "const": "passed",
      "default": "passed",
      "title": "Status",
      "type": "string"
    },
    "target_pid": {
      "exclusiveMinimum": 0,
      "title": "Target Pid",
      "type": "integer"
    },
    "target_start_time_ticks": {
      "exclusiveMinimum": 0,
      "title": "Target Start Time Ticks",
      "type": "integer"
    },
    "target_uid": {
      "minimum": 0,
      "title": "Target Uid",
      "type": "integer"
    },
    "trace_backend_status": {
      "default": "not_requested",
      "enum": [
        "not_requested",
        "available"
      ],
      "title": "Trace Backend Status",
      "type": "string"
    },
    "trace_modes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CollectorTraceModeAcceptance"
      },
      "title": "Trace Modes",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "perflens_version",
    "acceptance_id",
    "socket_path",
    "target_pid",
    "target_uid",
    "target_start_time_ticks",
    "requested_duration_seconds",
    "collection_id",
    "output_path",
    "output_sha256",
    "output_bytes",
    "metric_count",
    "started_at",
    "finished_at"
  ],
  "title": "CollectorAcceptanceArtifact",
  "type": "object"
}
