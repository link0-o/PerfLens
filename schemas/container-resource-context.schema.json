{
  "$defs": {
    "CgroupIoDeviceLimit": {
      "additionalProperties": false,
      "description": "One normalized cgroup-v2 ``io.max`` device limit.\n\nA missing value means that dimension is unlimited. Entries where every\ndimension is unlimited are omitted by the parser, so exported entries\nalways carry at least one effective limit.",
      "properties": {
        "major": {
          "minimum": 0,
          "title": "Major",
          "type": "integer"
        },
        "minor": {
          "minimum": 0,
          "title": "Minor",
          "type": "integer"
        },
        "read_bps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Bps"
        },
        "read_iops": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Iops"
        },
        "write_bps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write Bps"
        },
        "write_iops": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write Iops"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "title": "CgroupIoDeviceLimit",
      "type": "object"
    },
    "CgroupIoDeviceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "minimum": 0,
          "title": "Major",
          "type": "integer"
        },
        "minor": {
          "minimum": 0,
          "title": "Minor",
          "type": "integer"
        },
        "read_bytes": {
          "minimum": 0,
          "title": "Read Bytes",
          "type": "integer"
        },
        "read_ios": {
          "minimum": 0,
          "title": "Read Ios",
          "type": "integer"
        },
        "write_bytes": {
          "minimum": 0,
          "title": "Write Bytes",
          "type": "integer"
        },
        "write_ios": {
          "minimum": 0,
          "title": "Write Ios",
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor",
        "read_bytes",
        "write_bytes",
        "read_ios",
        "write_ios"
      ],
      "title": "CgroupIoDeviceSnapshot",
      "type": "object"
    },
    "ContainerResourceDelta": {
      "additionalProperties": false,
      "properties": {
        "cpu_nr_periods": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Nr Periods"
        },
        "cpu_nr_throttled": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Nr Throttled"
        },
        "cpu_system_usec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu System Usec"
        },
        "cpu_throttled_usec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Throttled Usec"
        },
        "cpu_usage_usec": {
          "minimum": 0,
          "title": "Cpu Usage Usec",
          "type": "integer"
        },
        "cpu_user_usec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu User Usec"
        },
        "io_pressure_full_usec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Io Pressure Full Usec"
        },
        "io_pressure_some_usec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Io Pressure Some Usec"
        },
        "io_read_bytes": {
          "minimum": 0,
          "title": "Io Read Bytes",
          "type": "integer"
        },
        "io_read_ios": {
          "minimum": 0,
          "title": "Io Read Ios",
          "type": "integer"
        },
        "io_write_bytes": {
          "minimum": 0,
          "title": "Io Write Bytes",
          "type": "integer"
        },
        "io_write_ios": {
          "minimum": 0,
          "title": "Io Write Ios",
          "type": "integer"
        },
        "memory_event_deltas": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Memory Event Deltas",
          "type": "array"
        },
        "memory_pressure_full_usec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Pressure Full Usec"
        },
        "memory_pressure_some_usec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Pressure Some Usec"
        }
      },
      "required": [
        "cpu_usage_usec",
        "io_read_bytes",
        "io_write_bytes",
        "io_read_ios",
        "io_write_ios"
      ],
      "title": "ContainerResourceDelta",
      "type": "object"
    },
    "ContainerResourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "cpu_nr_periods": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Nr Periods"
        },
        "cpu_nr_throttled": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Nr Throttled"
        },
        "cpu_period_usec": {
          "exclusiveMinimum": 0,
          "title": "Cpu Period Usec",
          "type": "integer"
        },
        "cpu_quota_usec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Quota Usec"
        },
        "cpu_system_usec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu System Usec"
        },
        "cpu_throttled_usec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Throttled Usec"
        },
        "cpu_usage_usec": {
          "minimum": 0,
          "title": "Cpu Usage Usec",
          "type": "integer"
        },
        "cpu_user_usec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu User Usec"
        },
        "cpuset_cpus_effective": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Cpuset Cpus Effective",
          "type": "string"
        },
        "io_devices": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CgroupIoDeviceSnapshot"
          },
          "title": "Io Devices",
          "type": "array"
        },
        "io_limits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CgroupIoDeviceLimit"
          },
          "title": "Io Limits",
          "type": "array"
        },
        "io_pressure": {
          "anyOf": [
            {
              "$ref": "#/$defs/PressureSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory_current_bytes": {
          "minimum": 0,
          "title": "Memory Current Bytes",
          "type": "integer"
        },
        "memory_events": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Memory Events",
          "type": "array"
        },
        "memory_max_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Max Bytes"
        },
        "memory_pressure": {
          "anyOf": [
            {
              "$ref": "#/$defs/PressureSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_at": {
          "title": "Observed At",
          "type": "string"
        },
        "pids_current": {
          "minimum": 0,
          "title": "Pids Current",
          "type": "integer"
        },
        "pids_max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids Max"
        }
      },
      "required": [
        "observed_at",
        "cpu_usage_usec",
        "cpu_period_usec",
        "cpuset_cpus_effective",
        "memory_current_bytes",
        "pids_current"
      ],
      "title": "ContainerResourceSnapshot",
      "type": "object"
    },
    "PressureSnapshot": {
      "additionalProperties": false,
      "properties": {
        "full_total_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full Total Us"
        },
        "some_total_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Some Total Us"
        }
      },
      "title": "PressureSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "after": {
      "$ref": "#/$defs/ContainerResourceSnapshot"
    },
    "allowed_conclusions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Allowed Conclusions",
      "type": "array"
    },
    "before": {
      "$ref": "#/$defs/ContainerResourceSnapshot"
    },
    "cgroup_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cgroup Identity Sha256",
      "type": "string"
    },
    "container_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Container Identity Sha256",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "delta": {
      "$ref": "#/$defs/ContainerResourceDelta"
    },
    "forbidden_conclusions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Forbidden Conclusions",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "perflens_version": {
      "title": "Perflens Version",
      "type": "string"
    },
    "quality_status": {
      "enum": [
        "verified",
        "partial"
      ],
      "title": "Quality Status",
      "type": "string"
    },
    "resource_context_id": {
      "pattern": "^container-resource-[a-f0-9]{20}$",
      "title": "Resource Context Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "entire_container_cgroup_v2",
      "default": "entire_container_cgroup_v2",
      "title": "Scope",
      "type": "string"
    },
    "source_collection_id": {
      "pattern": "^collection-[a-f0-9]{16}$",
      "title": "Source Collection Id",
      "type": "string"
    },
    "source_output_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Output Sha256",
      "type": "string"
    }
  },
  "required": [
    "perflens_version",
    "resource_context_id",
    "created_at",
    "container_identity_sha256",
    "cgroup_identity_sha256",
    "source_collection_id",
    "source_output_sha256",
    "before",
    "after",
    "delta",
    "quality_status",
    "content_sha256"
  ],
  "title": "ContainerResourceContextArtifact",
  "type": "object"
}
